---
/**
 * VIGIL, the group's flagship project. The facts are in src/lib/vigil.ts, each with its sources,
 * and the videos and press are the media items marked `project: vigil`.
 */
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cite from '../components/Cite.astro';
import Clip from '../components/Clip.astro';
import MediaRow from '../components/MediaRow.astro';
import PubItem from '../components/PubItem.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import VideoCard from '../components/VideoCard.astro';
import VigilName from '../components/VigilName.astro';
import { getMedia, getPublications } from '../lib/content';
import { href } from '../lib/site';
import { SOURCES, vigil, type SourceId } from '../lib/vigil';
import { RELATED_POSTERS, SYSTEM_POSTERS } from '../lib/vigil-posters';
import heartScan from '../assets/vigil/demo-day-heart-scan.jpg';
import legScan from '../assets/vigil/demo-day-leg-scan.jpg';
import teamPhoto from '../assets/vigil/demo-day-team.jpg';
import mockClinic from '../assets/vigil/mock-clinic-empty.jpg';
import mockClinicExam from '../assets/vigil/mock-clinic-exam.jpg';
import vigilMark from '../assets/vigil/vigil-mark.png';
import teamWall from '../assets/vigil/vigil-team.jpg';
import feedback from '../assets/clips/vigil-feedback.mp4';
import projection from '../assets/clips/vigil-projection.mp4';
import question from '../assets/clips/vigil-question.mp4';
import sensing from '../assets/clips/vigil-sensing.mp4';
import viewScoring from '../assets/clips/vigil-view-scoring.mp4';
import feedbackPoster from '../assets/clips/posters/vigil-feedback.jpg';
import projectionPoster from '../assets/clips/posters/vigil-projection.jpg';
import questionPoster from '../assets/clips/posters/vigil-question.jpg';
import sensingPoster from '../assets/clips/posters/vigil-sensing.jpg';
import viewScoringPoster from '../assets/clips/posters/vigil-view-scoring.jpg';

const { award, services } = vigil;
const media = (await getMedia()).filter((item) => item.data.project === 'vigil');
/** The two demonstration videos that the clips below are cut from, shown in full under them. */
const DEMOS = ['vigil-demo-task-guidance', 'vigil-demo-lower-limb-dvt'];
const demos = DEMOS.flatMap((id) => media.filter((item) => item.id === id));
const talk = media.find((item) => item.data.youtubeId && !DEMOS.includes(item.id));
const coverage = media.filter((item) => item !== talk && !DEMOS.includes(item.id));
const publications = await getPublications();
const papers = vigil.papers.flatMap((id) => publications.filter((pub) => pub.id === id));
const sources = Object.entries(SOURCES) as [SourceId, (typeof SOURCES)[SourceId]][];

/**
 * The team's own footage of each part of the system, in the order of vigil.steps. Four of the five
 * clips are cut from the two demonstration videos that Prof. Corso published in November and
 * December 2025 (the `demos` above); the view-scoring clip is from his 2026 talk. Any captions
 * inside them are the team's.
 */
const footage = [
  [
    {
      clip: sensing,
      poster: sensingPoster,
      alt: "A split screen. On the left, a gray 3D model of a person's legs, with a green patch on the upper thigh and a blue dot that moves as the probe moves. On the right, the camera's view of a real leg from above, with dots tracking the hand that holds the probe.",
      title: 'The room, in 3D.',
      caption:
        "Left, the probe's position and how much of the scan is done, drawn on a 3D model posed like the patient. Right, the camera's view, with the hand on the probe tracked.",
    },
  ],
  [
    {
      clip: viewScoring,
      poster: viewScoringPoster,
      alt: 'Two copies of a live ultrasound of the heart. The left is plain. On the right, dots trace the wall of the left ventricle, a frame around the image changes between green, yellow, and red, and a reading of LVEF, near 62 percent, updates.',
      title: 'Reading the view.',
      caption:
        "Left, the ultrasound as it arrives. Right, landmarks traced on the heart, a frame that turns green, yellow, or red as the probe is on, near, or far from the four-chamber view, and an estimate of ejection fraction (LVEF), the share of the left ventricle's blood pumped out with each beat.",
    },
    {
      clip: question,
      poster: questionPoster,
      alt: 'A clinician holding an ultrasound probe asks a question, shown as a caption: Hi VIGIL, what is in this view? A monitor behind her shows the ultrasound in a yellow frame, and a caption gives the reply: This appears to be an apical four-chamber (A4C) view with suboptimal visibility.',
      title: 'Answering a question.',
      caption:
        'The clinician asks, "Hi VIGIL, what\'s in this view?" It answers: an apical four-chamber view, with suboptimal visibility.',
    },
  ],
  [
    {
      clip: projection,
      poster: projectionPoster,
      alt: 'Seen from above, a patient in a gown lies on a bed while a clinician stands at the head. Lines of light projected onto the bed show where the patient should lie. A close-up then shows a score projected onto the bed beside the patient.',
      title: 'In the room.',
      caption:
        'Light on the bed lines the patient up. Then the system projects its reading onto the bed beside them.',
    },
    {
      clip: feedback,
      poster: feedbackPoster,
      alt: 'A clinician scans a patient while a monitor shows the ultrasound in a yellow frame. The picture then cuts to the screen itself: the ultrasound with the four chambers of the heart colored in, and beside it a 3D probe drawn at its current angle against the target angle.',
      title: 'On the screen.',
      caption:
        "Color-coded feedback: a frame around the ultrasound view, and the probe's current angle drawn against the target.",
    },
  ],
  [
    {
      photo: mockClinic,
      alt: 'An empty exam bay built from an aluminum frame: a curtained wall with two monitors, an exam table, a large screen showing the bay from above, and a sign reading VIGIL, Michigan Robotics, ARPA-H.',
      title: 'The mock clinic.',
      caption:
        'The team develops VIGIL in a bay built to stand in for the vehicle: a frame carrying its cameras and screens around an exam table.',
    },
  ],
] as const;

/** The team picture at the size it was made, for finding a face in it. */
const teamWallFull = await getImage({ src: teamWall, width: teamWall.width, quality: 88 });

const plate = [
  { name: 'Funder', value: `${award.funderName} (${award.funder})` },
  { name: 'Program', value: `${award.program}, ${award.area}` },
  { name: 'Award', value: `${award.amount}, begun ${award.started}` },
  { name: 'Principal investigator', value: award.pi },
  { name: 'Led from', value: award.prime },
];
---

<Base
  title="VIGIL"
  description="VIGIL is the Corso Group's flagship project: an AI agent, funded by ARPA-H's PARADIGM program, that guides generalist clinicians through specialist exams and procedures so hospital-level care can reach rural America."
>
  <header class="page-head">
    <div class="container">
      <p class="label head-label">
        <Image src={vigilMark} alt="The VIGIL logo" width={56} height={56} />
        Flagship project &middot; {award.funder} {award.program}
      </p>
      <h1 class="page-title wordmark">
        {vigil.name}
        <span class="sr-only">: {vigil.fullName}</span>
      </h1>
      <div class="head-foot">
        <div>
          <VigilName decorative />
          <p class="lead">{vigil.summary}</p>
          <div class="cta">
            <a class="btn btn--primary" href="#how">
              See it work{' '}
              <span class="arrow" aria-hidden="true">
                &darr;
              </span>
            </a>
            <a class="btn" href="#watch">
              Watch the talk
            </a>
          </div>
        </div>
        <div>
          <dl class="plate">
            {plate.map((row) => (
              <div>
                <dt class="label">{row.name}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          <p class="plate-note">
            As listed by ARPA-H
            <Cite ids={['award']} />
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="section room-photos" id="in-the-room">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">In the room</p>
          <h2 class="h2">
            A working system in under a <em>year</em>.
          </h2>
          <p>
            In November 2025, nine months after the award, the team demonstrated VIGIL live at
            ARPA-H's PARADIGM meeting in Washington, guiding people through ultrasound exams.
            <Cite ids={['demo']} />
          </p>
        </div>
      </div>
      <figure class="photo photo--lead" data-reveal>
        <Image
          src={mockClinicExam}
          alt="A team member holds an ultrasound probe to the abdomen of a volunteer lying on an exam table. Behind them, a large screen shows the same exam from above, as the room's camera sees it."
          widths={[640, 960, 1280, 1600, 2400]}
          sizes="(min-width: 86rem) 80rem, 92vw"
          quality={80}
        />
        <figcaption>
          <strong>In the group's mock clinic at Michigan.</strong> A team member scans a volunteer.
          The screen behind them shows the exam from above: what the room's camera sees, and what
          VIGIL works from.
        </figcaption>
      </figure>
      <div class="photos" data-reveal="stagger">
        <figure class="photo photo--tall">
          <Image
            src={legScan}
            alt="A clinician scans the thigh of a patient lying on a bed. Green light is projected onto the leg, and a screen in front shows a model of the leg with the probe's position marked."
            widths={[480, 720, 1008]}
            sizes="(min-width: 62rem) 38vw, 92vw"
            quality={82}
          />
          <figcaption>
            <strong>The leg.</strong> The green marks on the thigh are projected by VIGIL. The
            screen shows where the probe is on a model of the patient's own body.
          </figcaption>
        </figure>
        <figure class="photo">
          <Image
            src={heartScan}
            alt="A clinician holds an ultrasound probe to the chest of a man lying on an exam table, beside three monitors. One shows an ultrasound image of the heart outlined in red."
            widths={[480, 720, 978]}
            sizes="(min-width: 62rem) 38vw, 92vw"
            quality={82}
          />
          <figcaption>
            <strong>The heart.</strong> The frame around the ultrasound image is the system's
            color-coded feedback on the view, here red. Beside it, the probe's angle is drawn
            against its target.
          </figcaption>
        </figure>
        <figure class="photo">
          <Image
            src={teamPhoto}
            alt="Thirteen members of the VIGIL team, one in a patient gown, around a screen showing the VIGIL logo."
            widths={[480, 720, 978]}
            sizes="(min-width: 62rem) 38vw, 92vw"
            quality={82}
          />
          <figcaption>
            <strong>The team</strong> at the demonstration, including the day's patients.
          </figcaption>
        </figure>
      </div>
      <p class="photo-credit" data-reveal>
        <a class="link" href={SOURCES.demo.href} rel="noopener">
          Jason Corso's post about the meeting
        </a>{' '}
        is the source of its three photos. The mock clinic photo is courtesy of the group.
      </p>
    </div>
  </section>

  <section class="section band--blue how" id="how">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">How it works</p>
          <h2 class="h2">
            An agent that sees the room, and <em>guides</em> in it.
          </h2>
        </div>
      </div>

      <ol class="parts">
        {vigil.steps.map((step, i) => (
          <li class="part" data-reveal>
            <div class="part-text">
              <p class="step-name">
                <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
                {step.name}
              </p>
              <h3 class="h3">{step.title}</h3>
              <p class="step-body">
                {step.body}
                <Cite ids={step.sources} />
              </p>
            </div>
            <div class="part-media" data-count={footage[i].length}>
              {footage[i].map((item) =>
                'clip' in item ? (
                  <Clip src={item.clip} poster={item.poster} tag="Footage · VIGIL" alt={item.alt}>
                    <strong>{item.title}</strong> {item.caption}
                  </Clip>
                ) : (
                  <figure class="photo">
                    <Image
                      src={item.photo}
                      alt={item.alt}
                      widths={[480, 720, 960, 1280]}
                      sizes="(min-width: 62rem) 44rem, 92vw"
                      quality={80}
                    />
                    <figcaption>
                      <strong>{item.title}</strong> {item.caption}
                    </figcaption>
                  </figure>
                ),
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="note note--all" data-reveal>
        Four of these clips are cut from the two videos of the November 2025 demonstrations that
        Prof. Corso published, and the captions inside them are the team's. The view-scoring clip is
        the group's own recording.
        <Cite ids={['guidance', 'dvt']} />
      </p>

      <h3 class="h3 exams-head" data-reveal>
        The demonstrations, in full
      </h3>
      <div class="demos" data-reveal="stagger">
        {demos.map((item) => (
          <VideoCard item={item} sizes="(min-width: 62rem) 45vw, 92vw" />
        ))}
      </div>

      <h3 class="h3 exams-head" data-reveal>
        Two exams, start to finish
      </h3>
      <div class="exams" data-reveal="stagger">
        <div>
          <ResearchFigure topic="vigil" number={1} wide />
          <p class="note">
            <strong>The heart.</strong> Light marks where the probe goes, the system judges the
            probe as far, close, or on target, and a voice corrects it until the four chambers are
            in view.
          </p>
        </div>
        <div>
          <ResearchFigure topic="leg" number={2} wide />
          <p class="note">
            <strong>The leg.</strong> Marks along the thigh show where to press, the ultrasound
            shows each vein under the probe, and three bars count off the veins as they are scanned.
          </p>
        </div>
      </div>
      <p class="note note--all" data-reveal>
        These two figures are illustrations, drawn from the team's public descriptions and its demo
        day posters to show a whole exam in a few seconds. They are not footage, and the spoken
        lines are examples.
        <Cite ids={['detroit', 'posters']} />
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Why it matters</p>
          <h2 class="h2">
            The hospital keeps getting <em>farther</em> away.
          </h2>
        </div>
      </div>

      <div class="why" data-reveal="stagger">
        <div class="prose">
          <p>
            Over the past ten years, more than 100 hospitals in mostly rural parts of the United
            States have closed, and at least 600 more, about 30% of all rural hospitals, are at risk
            of closing.
            <Cite ids={['paradigm']} />
            When one closes, the people it served travel farther for the same care, or go without.
          </p>
          <p>
            {award.funder}'s {award.program} program is building a different model: a vehicle that
            carries hospital-level care to where people live. The program has five parts, from a
            miniaturized, ruggedized CT scanner to the software that brings a clinic's medical
            devices into one system. <strong>VIGIL is the fifth: intelligent task guidance</strong>,
            the part that lets the clinician on board do work that would otherwise wait for a
            specialist.
            <Cite ids={['paradigm', 'release']} />
          </p>
          <p>
            The person VIGIL works beside is a generalist: a family doctor, a nurse practitioner, a
            physician assistant. They have deep foundational knowledge and no specialist down the
            hall. The agent observes what they do, walks them through what is unfamiliar, and
            adjusts when something unexpected happens.
            <Cite ids={['michigan']} />
          </p>
        </div>

        <div class="why-side">
          <dl class="figures">
            <div>
              <dd>100+</dd>
              <dt>Rural hospitals closed in ten years</dt>
            </div>
            <div>
              <dd>600</dd>
              <dt>More at risk: about 30% of all rural hospitals</dt>
            </div>
          </dl>
          <figure class="quote">
            <blockquote>
              <p>We want to bring the hospital to the house, or to the church parking lot.</p>
            </blockquote>
            <figcaption>
              Jason Corso, in Michigan Engineering News
              <Cite ids={['michigan']} />
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section band--maize room">
    <div class="container">
      <div class="room-grid" data-reveal="stagger">
        <div>
          <p class="label">The interface</p>
          <h2 class="h2">
            No goggles. The interface is the <em>room</em>.
          </h2>
        </div>
        <div>
          <p class="lead">
            Guidance like this usually arrives on a headset. The team planned for one, then dropped
            it. In the clinic, VIGIL projects its guidance onto the patient and the room and speaks
            through an earpiece, so nothing sits between the clinician and the person they are
            caring for.
            <Cite ids={['goggles', 'detroit']} />
          </p>
          <ul class="reasons">
            <li>
              <h3 class="h3">Nothing to wear</h3>
              <p>No heavy headset, and none of the motion sickness that comes with one.</p>
            </li>
            <li>
              <h3 class="h3">Eye contact stays</h3>
              <p>The clinician looks at the patient, not at a screen in front of their eyes.</p>
            </li>
            <li>
              <h3 class="h3">It fits the room</h3>
              <p>The guidance lands on the table and the tools that are already in use.</p>
            </li>
          </ul>
          <p class="credit">
            The move to projected guidance was led by Anhong Guo, of Computer Science and
            Engineering at Michigan.
            <Cite ids={['goggles']} />
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Scope</p>
          <h2 class="h2">What it guides</h2>
          <p>
            In August 2026, eighteen months into the project, Prof. Corso counted four clinical
            services that VIGIL supports, among them ultrasound, X-ray, and laryngoscopy.
            <Cite ids={['update']} />
          </p>
        </div>
      </div>

      <div class="scope" data-reveal="stagger">
        <div>
          <h3 class="label">
            Shown or named so far
            <Cite ids={['detroit', 'update']} />
          </h3>
          <ul class="services">
            {services.now.map((service) => (
              <li>
                <span class="service-name">{service.name}</span>
                <span class="service-note">{service.note}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="label">
            Named as possible next steps
            <Cite ids={['detroit']} />
          </h3>
          <ul class="plain">
            {services.next.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="label">
            Also built
            <Cite ids={['detroit']} />
          </h3>
          <ul class="plain">
            {services.forms.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section progress">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Progress</p>
          <h2 class="h2">
            From award to <em>four</em> services in eighteen months.
          </h2>
        </div>
      </div>
      <ol class="timeline" data-reveal="stagger">
        {vigil.timeline.map((moment) => (
          <li>
            <p class="when">{moment.when}</p>
            <p class="what">
              {moment.what}
              <Cite ids={moment.sources} />
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band--blue" id="watch">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Watch and read</p>
          <h2 class="h2">VIGIL on the record</h2>
        </div>
        <a class="more" href={href('/media/')}>
          All talks, press, and essays{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <div class="record" data-reveal="stagger">
        {talk && <VideoCard item={talk} sizes="(min-width: 62rem) 45vw, 92vw" />}
        <ul class="rows record-list">
          {coverage.map((item) => (
            <MediaRow item={item} showKind />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section demo" id="demo-day">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Demo day, summer 2026</p>
          <h2 class="h2">
            What each team <em>showed</em>.
          </h2>
          <p>
            VIGIL is built in parts, by different teams, that meet in one room. These are the parts
            as the teams presented them on posters at the demo day.
            <Cite ids={['posters']} />
          </p>
        </div>
      </div>

      <ul class="posters" data-reveal="stagger">
        {SYSTEM_POSTERS.map((poster) => (
          <li class="poster">
            <p class="label poster-team">{poster.team}</p>
            <h3 class="h3">
              {poster.href ? (
                <a href={poster.href} rel="noopener">
                  {poster.title} <span aria-hidden="true">&nearr;</span>
                </a>
              ) : (
                poster.title
              )}
            </h3>
            <p class="poster-what">{poster.what}</p>
            {poster.result && (
              <p class="poster-result">
                <strong>{poster.result.value}</strong>
                <span>{poster.result.label}</span>
              </p>
            )}
            <p class="poster-people">
              {poster.people}
              {poster.venue && <span class="poster-venue">{poster.venue}</span>}
            </p>
          </li>
        ))}
      </ul>

      <h3 class="label related-head" data-reveal>
        Shown alongside: research from the same groups
      </h3>
      <ul class="rows related" data-reveal="stagger">
        {RELATED_POSTERS.map((poster) => (
          <li>
            <p class="related-team">
              <span>{poster.team}</span>
              {poster.venue && <span class="related-venue">{poster.venue}</span>}
            </p>
            <div>
              <h4>
                <a href={poster.href} rel="noopener">
                  {poster.title} <span aria-hidden="true">&nearr;</span>
                </a>
              </h4>
              <p class="related-what">
                {poster.what}
                {poster.result && (
                  <span class="related-result">
                    {' '}
                    {poster.result.value}: {poster.result.label.toLowerCase()}.
                  </span>
                )}
              </p>
              <p class="related-people">{poster.people}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Team</p>
          <h2 class="h2">
            Nine universities and RTX BBN, <em>one</em> team.
          </h2>
          <p>
            The team as it was announced in February 2025, in its three sub-teams,
            <Cite ids={['michigan']} />
            with Cornell Tech, where Andrew Owens has since moved.
            <Cite ids={['cornell', 'posters']} />
            The program manager at {award.funder} is {award.manager}.
            <Cite ids={['paradigm']} />
          </p>
        </div>
        <a class="more" href={href('/people/')}>
          The Corso Group{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <figure class="team-wall" data-reveal>
        <a href={teamWallFull.src} aria-label="Open the picture of the VIGIL team at full size">
          <Image
            src={teamWall}
            alt="A honeycomb of portrait photographs of the people of the VIGIL team, arranged around the VIGIL logo. Each portrait carries the logo of its institution: Michigan, Central Michigan, Colorado State, Cornell Tech, Northeastern, Penn, Purdue, RTX, Rochester, and Stevens."
            widths={[640, 960, 1280, 1600, 2048]}
            sizes="(min-width: 86rem) 80rem, 92vw"
            quality={82}
          />
        </a>
        <figcaption>
          <strong>The team.</strong> Faculty, clinicians, staff, and students at ten institutions,
          in the picture Prof. Corso shared for the annual site visit in May 2026. The outline of
