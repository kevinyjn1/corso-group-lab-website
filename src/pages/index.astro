---
import { Image } from 'astro:assets';
import heartExam from '../assets/vigil/heart-exam-mock-clinic.jpg';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import VigilBand from '../components/VigilBand.astro';
import { AREA_VISUALS, type AreaId } from '../lib/area-visuals';
import { paperOf, shortCite } from '../lib/cite';
import { getAreas, getPeople, getPublications } from '../lib/content';
import { PAPER_FIGURES } from '../lib/paper-figures';
import { href, pi, site } from '../lib/site';
import { thesis } from '../lib/thesis';

/*
 * The home page is a brief introduction to the group: what it is for, who is in it, what it
 * works on, its project in the field, and its newest papers. The argument behind the headline,
 * with its results, is on the Research page.
 */

const publications = await getPublications();
const areas = await getAreas();
const people = await getPeople();

/** Each research area with the picture on its card: part of a figure from one of its papers. */
const areaCards = areas.map((area) => {
  const visual = AREA_VISUALS[area.id as AreaId];
  if (!visual || !('card' in visual)) {
    throw new Error(`Home: the area "${area.id}" has no card in src/lib/area-visuals.ts`);
  }
  const figure = PAPER_FIGURES[visual.card.figure];
  const pub = paperOf(publications, figure.paper, 'Home, research cards');
  return { area, card: visual.card, source: `From ${figure.label} of ${shortCite(pub)}` };
});

const latest = publications.slice(0, 4);
const current = (role: string) =>
  people.filter((p) => p.data.status === 'current' && p.data.role === role);
const students = current('phd');
/** Who else is in the group, by role. The People page has the names. */
const others = (
  [
    [current('undergrad').length, 'An undergraduate researcher', 'Undergraduate researchers'],
    [current('postdoc').length, 'A postdoctoral fellow', 'Postdoctoral fellows'],
    [current('staff').length, 'A staff member', 'Staff'],
    [current('collaborator').length, 'A collaborator', 'Collaborators'],
  ] as const
)
  .filter(([count]) => count > 0)
  .map(([count, one, many]) => (count === 1 ? one : many));
const phdAlumni = people.filter((p) => p.data.status === 'alumni' && p.data.role === 'phd');

/**
 * Some of the venues the group publishes at, said once in the publications section. Each venue
 * named here has to have at least five of the group's papers, or the build stops. The sentence
 * does not say "mainly" or "most": other venues have as many papers as some of these.
 */
const VENUES = [
  { field: 'computer vision', names: ['CVPR', 'ICCV', 'ECCV'] },
  { field: 'AI', names: ['AAAI'] },
  { field: 'medical imaging', names: ['MICCAI'] },
  { field: 'robotics', names: ['ICRA'] },
];
for (const name of VENUES.flatMap((venue) => venue.names)) {
  const count = publications.filter((p) => p.data.venueShort === name).length;
  if (count < 5)
    throw new Error(`The home page names ${name}, which has ${count} papers on the list.`);
}
const list = (names: string[]) =>
  names.length < 3 ? names.join(' and ') : `${names.slice(0, -1).join(', ')}, and ${names.at(-1)}`;
const venueSentence = `The group's papers appear at ${list(
  VENUES.map((venue) => `${list(venue.names)} in ${venue.field}`),
)}, among other venues.`;

const placements = [
  'Google',
  'Microsoft',
  'Salesforce',
  'Amazon',
  'Intel',
  'Bosch',
  'University of Rochester',
  'University of Maine',
  'SUNY at Buffalo',
  'University of Leeds',
];
---

<Base>
  <section class="hero">
    <div class="container">
      {/* The headline is the title of Prof. Corso's 2026 talk, word for word. See lib/thesis.ts. */}
      <h1 class="display hero-title">
        Physically-grounded agentic <em>upskilling</em>.
      </h1>
      <div class="hero-body">
        <div class="hero-text">
          <p class="lead">
            {thesis.definition} That is the aim of the {site.name} at the {site.university}: put the
            person and the AI on one team, and ground the AI in reality.
          </p>
          <div class="cta">
            <a class="btn btn--primary" href={href('/research/#thesis')}>
              The thesis{' '}
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
            <a class="btn" href={href('/vigil/')}>
              See it at work
            </a>
          </div>
        </div>
        <figure class="hero-photo">
          <a
            class="hero-frame"
            href={href('/vigil/')}
            aria-label="VIGIL: the guided exam in this photograph"
          >
            <Image
              src={heartExam}
              alt="A person lies on an exam table in a curtained bay framed in aluminum. A team member beside the table points at two wall monitors. Each monitor shows a heart ultrasound twice: once plain, and once with the heart's outline traced and a green frame around it. A sign above reads VIGIL, Michigan Robotics, ARPA-H."
              widths={[480, 720, 960, 1280, 1600]}
              sizes="(min-width: 60rem) 36rem, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <figcaption>
            A team member demonstrates a heart exam guided by VIGIL, the group's ARPA-H project, in
            its mock clinic at Michigan. Each monitor shows the live ultrasound beside the system's
            reading of it.
          </figcaption>
        </figure>
        <div class="hero-more">
          <dl class="words">
            {thesis.words.map((entry) => (
              <div>
                <dt>{entry.word}</dt>
                <dd>{entry.means}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">People</p>
          <h2 class="h2">A group with a long reach.</h2>
        </div>
        <a class="more" href={href('/people/')}>
          Meet the group{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <div class="people" data-reveal="stagger">
        <p class="lead">
          The group is led by {pi.name}, Michigan's Toyota Professor of Artificial Intelligence.{' '}
          <a class="link" href={pi.honors[0].href} rel="noopener">
            The chair recognizes
          </a>{' '}
          his contributions to computer vision and multimodal AI and his work "translating AI
          research into real-world applications". The group has graduated {phdAlumni.length} Ph.D.
          students since 2009, who have gone on to research and faculty positions across industry
          and academia.
        </p>
        <div class="people-side">
          <dl class="roster">
            <div>
              <dt class="label">Principal investigator</dt>
              <dd>{pi.name}</dd>
            </div>
            <div>
              <dt class="label">Ph.D. students</dt>
              {students.map((s) => (
                <dd>{s.data.name}</dd>
              ))}
            </div>
            {others.length > 0 && (
              <div>
                <dt class="label">Also in the group</dt>
                {others.map((line) => (
                  <dd>{line}</dd>
                ))}
              </div>
            )}
          </dl>
        </div>
        <div class="alumni">
          <p class="label">Where alumni have worked</p>
          <ul class="placements">
            {placements.map((place) => (
              <li class="chip">{place}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Research</p>
          <h2 class="h2">
            Six <em>connected</em> areas.
          </h2>
        </div>
        <a class="more" href={href('/research/')}>
          All research{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <ul class="areas" data-reveal="stagger">
        {areaCards.map(({ area, card, source }) => (
          <li>
            <a class="area" href={href(`/research/#${area.id}`)} data-topic={area.id}>
              <div class="area-figure">
                <Image
                  src={card.image}
                  alt={card.alt}
                  widths={[480, 720, 960, 1400].filter((width) => width <= card.image.width)}
                  sizes="(min-width: 62rem) 30vw, (min-width: 38rem) 46vw, 92vw"
                  quality={84}
                />
              </div>
              <div class="area-text">
                <h3 class="h3">{area.data.title}</h3>
                <p>{area.data.summary}</p>
                <span class="area-source">{source}</span>
                <span class="area-count">
                  <span class="dot" />
                  Papers{' '}
                  <span class="arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <VigilBand />

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Publications</p>
          <h2 class="h2">The latest work</h2>
          <p>{venueSentence}</p>
        </div>
        <a class="more" href={href('/publications/')}>
          All publications{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <ul class="rows" data-reveal="stagger">
        {latest.map((pub) => (
          <PubItem pub={pub} />
        ))}
      </ul>
    </div>
  </section>

  <section class="join band--maize">
    <div class="container" data-reveal>
      <p class="label">Join the group</p>
      <h2 class="display">
        Work <em>with</em> us.
      </h2>
      <div class="join-foot">
        <p class="lead">
          Interested in a Ph.D. in vision, language, and robotics? Prospective students apply
          through the University of Michigan graduate programs. Here is how to indicate your
          interest in the group.
        </p>
        <a class="btn btn--primary" href={href('/join/')}>
          How to join{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero ----------------------------------------------------------------- */

  /* The first screen holds the thesis, what it means, and the real system at work. */
  .hero {
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(2rem, 4vw, 3.25rem);
  }

  /*
   * One line from a tablet up, two on a phone. The title is about 18.7 times as wide as its font
   * size, so the size is the width of the page divided by a little more than that.
   */
  .hero-title {
    font-size: clamp(1.75rem, 8.4vw, 2.5rem);
    animation: rise-in 0.8s var(--ease) both;
  }

  @media (min-width: 46rem) {
    .hero-title {
      font-size: min(calc((100vw - 2 * var(--gutter)) / 19.1), 4.15rem);
    }
  }

  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    grid-template-areas:
      'text photo'
      'more photo';
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: clamp(1.5rem, 2.6vw, 2.25rem) clamp(2rem, 4.5vw, 4.5rem);
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
    border-top: var(--rule) solid var(--text);
  }

  .hero-text {
    grid-area: text;
    animation: rise-in 0.8s var(--ease) 0.12s both;
  }

  .hero-text .lead {
    max-width: 38rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  /* The photograph's column is as tall as the text's. Where the text runs longer, the frame
     grows to meet it and shows a little more of the room. */
  .hero-photo {
    display: flex;
    flex-direction: column;
    grid-area: photo;
    align-self: stretch;
    margin: 0;
    animation: rise-in 0.8s var(--ease) 0.2s both;
  }

  .hero-frame {
    position: relative;
    display: block;
    flex: 1 0 auto;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: var(--rule) solid var(--text);
    box-shadow: 8px 8px 0 var(--maize);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .hero-frame:hover,
  .hero-frame:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--maize);
  }

  /* The sign and the monitors are in the upper part of the photograph, so the crop keeps the top. */
  .hero-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  .hero-photo figcaption {
    max-width: 36rem;
    margin-top: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  /* The three words sit at the foot of the column, level with the foot of the photograph's
     caption, so the two columns start and end together. */
  .hero-more {
    grid-area: more;
    align-self: end;
    max-width: 38rem;
    animation: rise-in 0.8s var(--ease) 0.28s both;
  }

  /* What each word of the thesis is doing. */
  .words {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .words div {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }

  .words dt {
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .words dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-2);
  }

  @media (max-width: 60rem) {
    .hero-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'photo'
        'more';
      grid-template-rows: auto;
    }

    .hero-photo {
      max-width: 40rem;
    }
  }

  @media (max-width: 38rem) {
    .words div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }

  /* --- Research areas ------------------------------------------------------- */

  /* The six areas, three across. */
  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .area {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Part of a figure from one of the area's papers, on the white it was printed on. It lifts off
     a hard shadow in the area's own color. */
  .area-figure {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #fff;
    border: var(--rule) solid var(--text);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .area:hover .area-figure,
  .area:focus-visible .area-figure {
    transform: translate(-6px, -6px);
    box-shadow: 6px 6px 0 var(--topic);
  }

  .area-figure img {
    position: absolute;
    inset: 0.6rem;
    width: calc(100% - 1.2rem);
    height: calc(100% - 1.2rem);
    object-fit: contain;
  }

  .area-source {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }

  .area-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
  }

  .area-text p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .area-count {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .area-count .arrow {
    transition: transform 0.25s var(--ease);
  }

  .area:hover .area-count .arrow {
    transform: translateX(5px);
  }

  /* --- People --------------------------------------------------------------- */

  .people {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
    margin: 0;
  }

  /* The student list is the tall column; the shorter blocks stack beside it. */
  .roster div:nth-child(2) {
    grid-row: span 2;
  }

  .roster dt {
    margin-bottom: 0.6rem;
  }

  .roster dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.22;
  }

  /* Where the group's graduates went, on one line across both columns, so neither column has to
     carry it and run longer than the other. */
  .alumni {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .alumni .placements {
    margin-top: 0;
  }

  .placements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  /* --- Join ----------------------------------------------------------------- */

  .join {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .join .label {
    margin-bottom: 1rem;
    color: var(--text);
  }

  .join-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: var(--rule) solid var(--text);
  }

  .join-foot .lead {
    max-width: 44rem;
  }

  /* --- Responsive ----------------------------------------------------------- */

  @media (max-width: 62rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 44rem) {
    .join-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 38rem) {
    /* On a phone the roster is one column, so no count or title is squeezed onto two lines. */
    .roster {
      grid-template-columns: minmax(0, 1fr);
    }

    .roster div:nth-child(2) {
      grid-row: auto;
    }

    .areas {
      grid-template-columns: minmax(0, 1fr);
    }

    .cta .btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-text,
    .hero-photo,
    .hero-more {
      animation: none;
    }
  }
</style>
