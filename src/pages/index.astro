---
import { Image } from 'astro:assets';
import heartExam from '../assets/vigil/heart-exam-mock-clinic.jpg';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import PubItem from '../components/PubItem.astro';
import MediaRow from '../components/MediaRow.astro';
import FigureSource from '../components/FigureSource.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import VideoCard from '../components/VideoCard.astro';
import Thesis from '../components/Thesis.astro';
import VigilBand from '../components/VigilBand.astro';
import { getAreas, getMedia, getPeople, getPublications, getResources } from '../lib/content';
import type { FigureName } from '../lib/figures';
import { href, pi, site } from '../lib/site';
import { thesis } from '../lib/thesis';

const publications = await getPublications();
const areas = await getAreas();
const resources = await getResources();
const people = await getPeople();
const featuredMedia = (await getMedia())
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const leadVideo = featuredMedia.find((item) => item.data.youtubeId);

/** Human-AI collaboration is the thesis above, so the grid shows the five areas around it. */
const THESIS_AREA = 'human';
const otherAreas = areas.filter((area) => area.id !== THESIS_AREA);

const latest = publications.slice(0, 6);
const featuredResources = resources.filter((r) => r.data.featured);
const current = (role: string) =>
  people.filter((p) => p.data.status === 'current' && p.data.role === role);
const students = current('phd');
/** Who else is in the group, by role. The People page has the names. */
const others = (
  [
    [current('undergrad').length, 'An undergraduate researcher', 'Undergraduate researchers'],
    [current('researcher').length, 'A research scientist', 'Research scientists'],
    [current('staff').length, 'A staff member', 'Staff'],
    [current('collaborator').length, 'A collaborator', 'Collaborators'],
  ] as const
)
  .filter(([count]) => count > 0)
  .map(([count, one, many]) => (count === 1 ? one : many));
const phdAlumni = people.filter((p) => p.data.status === 'alumni' && p.data.role === 'phd');

/**
 * Where the group publishes, said once in the publications section. Each venue named here has to
 * have at least five of the group's papers, or the build stops: the sentence may not outrun the list.
 */
const VENUES = [
  { field: 'computer vision', names: ['CVPR', 'ICCV', 'ECCV'] },
  { field: 'AI', names: ['AAAI'] },
  { field: 'medical imaging', names: ['MICCAI'] },
  { field: 'robotics', names: ['ICRA'] },
];
for (const name of VENUES.flatMap((venue) => venue.names)) {
  const count = publications.filter((p) => p.data.venueShort === name).length;
  if (count < 5)
    throw new Error(`The home page names ${name}, which has ${count} papers on the list.`);
}
const list = (names: string[]) =>
  names.length < 3 ? names.join(' and ') : `${names.slice(0, -1).join(', ')}, and ${names.at(-1)}`;
const venueSentence = `The group publishes mainly at ${list(
  VENUES.map((venue) => `${list(venue.names)} in ${venue.field}`),
)}.`;

const placements = [
  'Google',
  'Microsoft',
  'Salesforce',
  'Amazon',
  'Intel',
  'Bosch',
  'University of Rochester',
  'University of Maine',
  'SUNY at Buffalo',
  'University of Leeds',
];
---

<Base>
  <section class="hero">
    <div class="container">
      {/* The headline is the title of Prof. Corso's 2026 talk, word for word. See lib/thesis.ts. */}
      <h1 class="display hero-title">
        Physically-grounded agentic <em>upskilling</em>.
      </h1>
      <div class="hero-body">
        <div class="hero-text">
          <p class="lead">
            {thesis.definition} That is the aim of the {site.name} at the {site.university}: put the
            person and the AI on one team, and ground the AI in reality.
          </p>
          <div class="cta">
            <a class="btn btn--primary" href="#thesis">
              The thesis{' '}
              <span class="arrow" aria-hidden="true">
                &darr;
              </span>
            </a>
            <a class="btn" href={href('/vigil/')}>
              See it at work
            </a>
          </div>
        </div>
        <figure class="hero-photo">
          <a
            class="hero-frame"
            href={href('/vigil/')}
            aria-label="VIGIL: the guided exam in this photograph"
          >
            <Image
              src={heartExam}
              alt="A person lies on an exam table in a curtained bay framed in aluminum. A team member beside the table points at two wall monitors. Each monitor shows a heart ultrasound twice: once plain, and once with the heart's outline traced and a green frame around it. A sign above reads VIGIL, Michigan Robotics, ARPA-H."
              widths={[480, 720, 960, 1280, 1600]}
              sizes="(min-width: 60rem) 36rem, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <figcaption>
            A team member demonstrates a heart exam guided by VIGIL, the group's ARPA-H project, in
            its mock clinic at Michigan. Each monitor shows the live ultrasound beside the system's
            reading of it.
          </figcaption>
        </figure>
        <div class="hero-more">
          <dl class="words">
            {thesis.words.map((entry) => (
              <div>
                <dt>{entry.word}</dt>
                <dd>{entry.means}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <Thesis />

  <VigilBand number="03" kicker="It is being proven in healthcare delivery" />

  <section class="stage band--blue">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">In the operating room</p>
          <h2 class="h2">
            One operation, read <em>four</em> ways.
          </h2>
          <p>
            Two decades of work by Prof. Corso and the group on surgery and the heart, shown on a
            single scene: a bypass graft being sewn onto a coronary artery.
          </p>
        </div>
      </div>
      <p class="stage-label">
        <span class="num">Fig. 3</span>
        An animated illustration, not footage. Pick a reading.
      </p>
      <HeroScene />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Research</p>
          <h2 class="h2">
            Five more threads, and what they <em>add</em>.
          </h2>
        </div>
        <a class="more" href={href('/research/')}>
          All research{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <ul class="areas" data-reveal="stagger">
        {otherAreas.map((area, i) => (
          <li>
            <a class="area" href={href(`/research/#${area.id}`)} data-topic={area.id}>
              <div class="area-figure">
                <ResearchFigure topic={area.id as FigureName} number={i + 4} />
              </div>
              <div class="area-text">
                <h3 class="h3">{area.data.title}</h3>
                <p>{area.data.summary}</p>
                <FigureSource topic={area.id as FigureName} link={false} />
                <span class="area-count">
                  <span class="dot" />
                  Papers{' '}
                  <span class="arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Publications</p>
          <h2 class="h2">The latest work</h2>
          <p>{venueSentence}</p>
        </div>
        <a class="more" href={href('/publications/')}>
          All publications{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <ul class="rows" data-reveal="stagger">
        {latest.map((pub) => (
          <PubItem pub={pub} />
        ))}
      </ul>
    </div>
  </section>

  {leadVideo && (
    <section class="section band--blue">
      <div class="container">
        <div class="section-head" data-reveal>
          <div>
            <p class="label">Media</p>
            <h2 class="h2">On the record</h2>
          </div>
          <a class="more" href={href('/media/')}>
            All talks, press, and essays{' '}
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </div>
        <div class="record" data-reveal="stagger">
          <VideoCard item={leadVideo} sizes="(min-width: 62rem) 55vw, 92vw" />
          <ul class="rows record-list">
            {featuredMedia
              .filter((item) => item !== leadVideo)
              .map((item) => (
                <MediaRow item={item} showKind />
              ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Code &amp; data</p>
          <h2 class="h2">Built in the open</h2>
          <p>
            Datasets, benchmarks, and software released by the group, from instructional video to
            surgical video, along with FiftyOne.
          </p>
        </div>
        <a class="more" href={href('/resources/')}>
          All releases{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <ul class="releases" data-reveal="stagger">
        {featuredResources.map((resource) => (
          <li class="release">
            <div class="release-head">
              <span class="chip">{resource.data.kind}</span>
              <span class="label">{resource.data.year}</span>
            </div>
            <h3 class="h3">
              <a href={resource.data.links[0].href} rel="noopener">
                {resource.data.name}
              </a>
            </h3>
            <p>{resource.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">People</p>
          <h2 class="h2">A group with a long reach.</h2>
        </div>
        <a class="more" href={href('/people/')}>
          Meet the group{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <div class="people" data-reveal="stagger">
        <p class="lead">
          The group is led by {pi.name}, Michigan's Toyota Professor of Artificial Intelligence.{' '}
          <a class="link" href={pi.honors[0].href} rel="noopener">
            The chair recognizes
          </a>{' '}
          his contributions to computer vision and multimodal AI and his work "translating AI
          research into real-world applications". The group has graduated {phdAlumni.length} Ph.D.
          students since 2009, who have gone on to research and faculty positions across industry
          and academia.
        </p>
        <div class="people-side">
          <dl class="roster">
            <div>
              <dt class="label">Principal investigator</dt>
              <dd>{pi.name}</dd>
            </div>
            <div>
              <dt class="label">Ph.D. students</dt>
              {students.map((s) => (
                <dd>{s.data.name}</dd>
              ))}
            </div>
            {others.length > 0 && (
              <div>
                <dt class="label">Also in the group</dt>
                {others.map((line) => (
                  <dd>{line}</dd>
                ))}
              </div>
            )}
          </dl>
          <div>
            <p class="label">Where alumni have worked</p>
            <ul class="placements">
              {placements.map((place) => (
                <li class="chip">{place}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="join band--maize">
    <div class="container" data-reveal>
      <p class="label">Join the group</p>
      <h2 class="display">
        Work <em>with</em> us.
      </h2>
      <div class="join-foot">
        <p class="lead">
          Interested in a Ph.D. in vision, language, and robotics? Prospective students apply
          through the University of Michigan graduate programs. Here is how to indicate your
          interest in the group.
        </p>
        <a class="btn btn--primary" href={href('/join/')}>
          How to join{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero ----------------------------------------------------------------- */

  /* The first screen holds the thesis, what it means, and the real system at work. */
  .hero {
    padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(2rem, 4vw, 3.25rem);
  }

  /*
   * One line from a tablet up, two on a phone. The title is about 18.7 times as wide as its font
   * size, so the size is the width of the page divided by a little more than that.
   */
  .hero-title {
    font-size: clamp(1.75rem, 8.4vw, 2.5rem);
    animation: rise-in 0.8s var(--ease) both;
  }

  @media (min-width: 46rem) {
    .hero-title {
      font-size: min(calc((100vw - 2 * var(--gutter)) / 19.1), 4.15rem);
    }
  }

  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    grid-template-areas:
      'text photo'
      'more photo';
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: clamp(1.5rem, 2.6vw, 2.25rem) clamp(2rem, 4.5vw, 4.5rem);
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
    border-top: var(--rule) solid var(--text);
  }

  .hero-text {
    grid-area: text;
    animation: rise-in 0.8s var(--ease) 0.12s both;
  }

  .hero-text .lead {
    max-width: 38rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .hero-photo {
    grid-area: photo;
    margin: 0;
    animation: rise-in 0.8s var(--ease) 0.2s both;
  }

  .hero-frame {
    display: block;
    border: var(--rule) solid var(--text);
    box-shadow: 8px 8px 0 var(--maize);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .hero-frame:hover,
  .hero-frame:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--maize);
  }

  /* The sign and the monitors are in the upper part of the photograph, so the crop keeps the top. */
  .hero-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 12%;
  }

  .hero-photo figcaption {
    max-width: 36rem;
    margin-top: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .hero-more {
    grid-area: more;
    max-width: 38rem;
    animation: rise-in 0.8s var(--ease) 0.28s both;
  }

  /* What each word of the thesis is doing. */
  .words {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .words div {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }

  .words dt {
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .words dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-2);
  }

  @media (max-width: 60rem) {
    .hero-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'photo'
        'more';
      grid-template-rows: auto;
    }

    .hero-photo {
      max-width: 40rem;
    }
  }

  @media (max-width: 38rem) {
    .words div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }

  /* --- The live scene ------------------------------------------------------- */

  .stage {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  /* The operating room follows the VIGIL band on the same blue. It leaves out the corner light
     that a blue band opens with, so the two meet as one field, with no edge between them. */
  :global(section.vigil) + .stage {
    padding-top: 0;
    background:
      linear-gradient(100deg, var(--band) 28%, transparent 88%),
      radial-gradient(circle at center, rgb(255 255 255 / 0.11) 1px, transparent 1.6px) 0 0 / 16px
        16px,
      var(--band);
  }

  .stage .section-head {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .stage-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--text-2);
  }

  .num {
    padding: 0.3rem 0.55rem;
    background: var(--maize);
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* --- Research areas ------------------------------------------------------- */

  /* Five areas on a six-column grid: three across, then two wider ones. */
  .areas {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .area {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .areas > li {
    grid-column: span 2;
  }

  .areas > li:nth-child(n + 4) {
    grid-column: span 3;
  }

  /* The screen lifts off a hard shadow in the area's own color. */
  .area-figure {
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .area:hover .area-figure,
  .area:focus-visible .area-figure {
    transform: translate(-6px, -6px);
    box-shadow: 6px 6px 0 var(--topic);
  }

  .area-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
  }

  .area-text p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .area-count {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .area-count .arrow {
    transition: transform 0.25s var(--ease);
  }

  .area:hover .area-count .arrow {
    transform: translateX(5px);
  }

  /* --- Media ---------------------------------------------------------------- */

  .record {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .record-list :global(.row) {
    grid-template-columns: minmax(0, 1fr);
  }

  .record-list :global(.where) {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .record-list :global(.chip) {
    justify-self: start;
  }

  /* --- Releases ------------------------------------------------------------- */

  .releases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .release {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 2px solid var(--text);
  }

  .release-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .release h3 a {
    background: linear-gradient(var(--maize), var(--maize)) left / 0 100% no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }

  .release h3 a:hover {
    background-size: 100% 100%;
    color: var(--blue);
  }

  .release p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* --- People --------------------------------------------------------------- */

  .people {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
    margin: 0;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  /* The student list is the tall column; the shorter blocks stack beside it. */
  .roster div:nth-child(2) {
    grid-row: span 2;
  }

  .roster dt {
    margin-bottom: 0.6rem;
  }

  .roster dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.22;
  }

  .people-side > div {
    padding-top: 1.5rem;
  }

  .placements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  /* --- Join ----------------------------------------------------------------- */

  .join {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .join .label {
    margin-bottom: 1rem;
    color: var(--text);
  }

  .join-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: var(--rule) solid var(--text);
  }

  .join-foot .lead {
    max-width: 44rem;
  }

  /* --- Responsive ----------------------------------------------------------- */

  @media (max-width: 62rem) {
    .releases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .areas > li,
    .areas > li:nth-child(n + 4) {
      grid-column: span 3;
    }

    .areas > li:last-child {
      grid-column: 1 / -1;
    }

    .people,
    .record {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 44rem) {
    .join-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 38rem) {
    /* On a phone the roster is one column, so no count or title is squeezed onto two lines. */
    .roster {
      grid-template-columns: minmax(0, 1fr);
    }

    .roster div:nth-child(2) {
      grid-row: auto;
    }

    .releases {
      grid-template-columns: minmax(0, 1fr);
    }

    .areas > li,
    .areas > li:nth-child(n + 4) {
      grid-column: 1 / -1;
    }

    .cta .btn {
