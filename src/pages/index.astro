---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import PubItem from '../components/PubItem.astro';
import VenueTicker from '../components/VenueTicker.astro';
import Logo from '../components/Logo.astro';
import MediaRow from '../components/MediaRow.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import VideoCard from '../components/VideoCard.astro';
import VigilBand from '../components/VigilBand.astro';
import {
  approx,
  getAreas,
  getMedia,
  getPeople,
  getPublications,
  getResources,
  isPeerReviewed,
} from '../lib/content';
import type { FigureName } from '../lib/figures';
import { href, pi, site } from '../lib/site';

/**
 * The headline is what Prof. Corso said an AI that guides people must do: "understand the task,
 * understand the human, and understand what's missing to fill in that gap."
 */
const headline = [
  ['Understand the task.'],
  ['Understand the ', { mark: 'human' }, '.'],
  ['Fill the gap.'],
];
const headlineSource =
  'https://www.stevens.edu/news/darpa-award-59-million-corso-and-teams-artificial-intelligence-program-will-learn-guide-humans';

const publications = await getPublications();
const areas = await getAreas();
const resources = await getResources();
const people = await getPeople();
const featuredMedia = (await getMedia())
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const leadVideo = featuredMedia.find((item) => item.data.youtubeId);

/** The area closest to the group's thesis leads the grid, at twice the size of the others. */
const LEAD_AREA = 'human';
const orderedAreas = [...areas].sort(
  (a, b) => Number(b.id === LEAD_AREA) - Number(a.id === LEAD_AREA),
);

const latest = publications.slice(0, 6);
const featuredResources = resources.filter((r) => r.data.featured);
const current = (role: string) =>
  people.filter((p) => p.data.status === 'current' && p.data.role === role);
const students = current('phd');
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
/** The rest of the group, as counts: the People page has the names. */
const others = [
  plural(current('undergrad').length, 'undergraduate researcher', 'undergraduate researchers'),
  plural(current('researcher').length, 'research scientist', 'research scientists'),
  plural(current('staff').length, 'staff member', 'staff'),
  plural(current('collaborator').length, 'collaborator', 'collaborators'),
].filter((line) => !line.startsWith('0 '));
const phdAlumni = people.filter((p) => p.data.status === 'alumni' && p.data.role === 'phd');
const countByTopic = (topic: string) =>
  publications.filter((p) => (p.data.topics as string[]).includes(topic)).length;

const stats = [
  { value: approx(publications.filter(isPeerReviewed).length), label: 'Peer-reviewed papers' },
  { value: site.scholar.citations, label: `Citations, as of ${site.scholar.asOf}` },
  { value: String(phdAlumni.length), label: 'Ph.D. graduates' },
  { value: String(resources.length), label: 'Open datasets and code releases' },
];

const placements = [
  'Google',
  'Microsoft',
  'Salesforce',
  'Amazon',
  'Intel',
  'Bosch',
  'University of Rochester',
  'University of Maine',
  'SUNY at Buffalo',
  'University of Leeds',
];
---

<Base>
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <h1 class="display">
          {headline.map((line, i) => (
            <span class="line" style={`--i: ${i}`}>
              <span>
                {line.map((part) => (typeof part === 'string' ? part : <em>{part.mark}</em>))}
              </span>
            </span>
          ))}
        </h1>
        <div class="hero-mark">
          <Logo size="100%" />
        </div>
      </div>
      <div class="hero-foot">
        <div>
          <p class="lead">
            The {site.name} at the {site.university} builds AI that watches people work with their
            hands and guides them through what they were never trained to do. It started in a
            kitchen, went on to battlefield medicine, and is now being built into mobile clinics for
            rural America.
          </p>
          <p class="hero-source">
            The headline is{' '}
            <a class="link" href={headlineSource} rel="noopener">
              Prof. Corso's own summary
            </a>{' '}
            of what such an AI has to do.
          </p>
        </div>
        <div class="cta">
          <a class="btn btn--primary" href={href('/research/')}>
            Explore the research{' '}
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
          <a class="btn" href={href('/publications/')}>
            Publications
          </a>
        </div>
      </div>
    </div>
  </section>

  <VigilBand figure={1} />

  <section class="numbers">
    <div class="container">
      <dl class="stats" data-reveal="stagger">
        {stats.map((stat) => (
          <div>
            <dd data-count>{stat.value}</dd>
            <dt>{stat.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <VenueTicker />

  <section class="stage band--blue">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">In the operating room</p>
          <h2 class="h2">
            One operation, read <em>four</em> ways.
          </h2>
          <p>
            Two decades of the group's work on surgery and the heart, shown on a single scene: a
            bypass graft being sewn onto a coronary artery.
          </p>
        </div>
      </div>
      <p class="stage-label">
        <span class="num">Fig. 2</span>
        Live, and an illustration, not footage. Pick a reading, or move over the scene.
      </p>
      <HeroScene />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Research</p>
          <h2 class="h2">
            Six threads, one aim: understand the work well enough to <em>help</em> with it.
          </h2>
        </div>
        <a class="more" href={href('/research/')}>
          All research{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <ul class="areas" data-reveal="stagger">
        {orderedAreas.map((area, i) => (
          <li class:list={{ lead: area.id === LEAD_AREA }}>
            <a class="area" href={href(`/research/#${area.id}`)} data-topic={area.id}>
              <div class="area-figure">
                <ResearchFigure topic={area.id as FigureName} number={i + 3} />
              </div>
              <div class="area-text">
                <h3 class="h3">{area.data.title}</h3>
                <p>{area.data.summary}</p>
                {area.id === LEAD_AREA && (
                  <ul class="area-threads">
                    {area.data.threads.map((thread) => (
                      <li class="chip">{thread}</li>
                    ))}
                  </ul>
                )}
                <span class="area-count">
                  <span class="dot" />
                  {countByTopic(area.id)} papers{' '}
                  <span class="arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Latest work</p>
          <h2 class="h2">Recent publications</h2>
        </div>
        <a class="more" href={href('/publications/')}>
          All {publications.length} publications{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <ul class="rows" data-reveal="stagger">
        {latest.map((pub) => (
          <PubItem pub={pub} />
        ))}
      </ul>
    </div>
  </section>

  {leadVideo && (
    <section class="section band--blue">
      <div class="container">
        <div class="section-head" data-reveal>
          <div>
            <p class="label">Media</p>
            <h2 class="h2">On the record</h2>
          </div>
          <a class="more" href={href('/media/')}>
            All talks, press, and essays{' '}
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </div>
        <div class="record" data-reveal="stagger">
          <VideoCard item={leadVideo} sizes="(min-width: 62rem) 55vw, 92vw" />
          <ul class="rows record-list">
            {featuredMedia
              .filter((item) => item !== leadVideo)
              .map((item) => (
                <MediaRow item={item} showKind />
              ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">Code &amp; data</p>
          <h2 class="h2">Built in the open</h2>
          <p>
            Datasets, benchmarks, and software released by the group, from instructional video to
            surgical video, and the tools to look closely at your own data.
          </p>
        </div>
        <a class="more" href={href('/resources/')}>
          All {resources.length} releases{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>

      <ul class="releases" data-reveal="stagger">
        {featuredResources.map((resource) => (
          <li class="release">
            <div class="release-head">
              <span class="chip">{resource.data.kind}</span>
              <span class="label">{resource.data.year}</span>
            </div>
            <h3 class="h3">
              <a href={resource.data.links[0].href} rel="noopener">
                {resource.data.name}
              </a>
            </h3>
            <p>{resource.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">People</p>
          <h2 class="h2">A group with a long reach.</h2>
        </div>
        <a class="more" href={href('/people/')}>
          Meet the group{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <div class="people" data-reveal="stagger">
        <p class="lead">
          The group is led by {pi.name}, Michigan's Toyota Professor of Artificial Intelligence, a
          chair that recognizes his contributions to computer vision and multimodal AI and{' '}
          <a class="link" href={pi.honors[0].href} rel="noopener">
            his work "translating AI research into real-world applications"
          </a>
          . The group has graduated {phdAlumni.length} Ph.D. students since 2009, who have gone on
          to research and faculty positions across industry and academia.
        </p>
        <div class="people-side">
          <dl class="roster">
            <div>
              <dt class="label">Principal investigator</dt>
              <dd>{pi.name}</dd>
              <dd class="roster-note">{pi.titles[0]}</dd>
            </div>
            <div>
              <dt class="label">Ph.D. students</dt>
              {students.map((s) => (
                <dd>{s.data.name}</dd>
              ))}
            </div>
            {others.length > 0 && (
              <div>
                <dt class="label">Also in the group</dt>
                {others.map((line) => (
                  <dd>{line}</dd>
                ))}
              </div>
            )}
          </dl>
          <div>
            <p class="label">Where alumni have worked</p>
            <ul class="placements">
              {placements.map((place) => (
                <li class="chip">{place}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="join band--maize">
    <div class="container" data-reveal>
      <p class="label">Join the group</p>
      <h2 class="display">
        Work <em>with</em> us.
      </h2>
      <div class="join-foot">
        <p class="lead">
          Interested in a Ph.D. in vision, language, and robotics? Prospective students apply
          through the University of Michigan graduate programs. Here is how to indicate your
          interest in the group.
        </p>
        <a class="btn btn--primary" href={href('/join/')}>
          How to join{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero ----------------------------------------------------------------- */

  .hero {
    padding-block: clamp(1.25rem, 2.6vw, 2.25rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-top {
    position: relative;
  }

  /* Each line of the headline rises from behind its own baseline. */
  .display .line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }

  .display .line > span {
    display: block;
    animation: line-in 0.95s var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }

  /* The mark sits beside the short last line, and watches the pointer. */
  .hero-mark {
    position: absolute;
    right: 0;
    bottom: 0.3rem;
    width: clamp(3.5rem, 8.6vw, 8rem);
    animation: mark-in 1.1s var(--ease-out) 0.35s both;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: var(--rule) solid var(--text);
  }

  .hero-foot .lead {
    max-width: 46rem;
    animation: rise-in 0.9s var(--ease) 0.5s both;
  }

  .hero-source {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--text-3);
    animation: rise-in 0.9s var(--ease) 0.6s both;
  }

  /* Three full sentences, so the headline is set smaller than a three word one would be. */
  .hero .display {
    font-size: clamp(2.35rem, 8.3vw, 8rem);
    line-height: 0.88;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise-in 0.9s var(--ease) 0.6s both;
  }

  @keyframes line-in {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.6);
    }
  }

  /* --- The live scene ------------------------------------------------------- */

  .stage {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .stage .section-head {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .stage-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--text-2);
  }

  .num {
    padding: 0.3rem 0.55rem;
    background: var(--maize);
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* --- Numbers -------------------------------------------------------------- */

  .numbers {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .stats div {
    padding: 0 clamp(1rem, 2vw, 2rem);
    border-left: var(--rule) solid var(--text);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 66%;
    font-size: clamp(3.5rem, 9vw, 8.5rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .stats dt {
    max-width: 14rem;
    margin-top: 0.9rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--text-2);
  }

  /* --- Research areas ------------------------------------------------------- */

  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .area {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* One area leads: two columns wide and two rows tall, so the grid is not six equal cards. */
  @media (min-width: 62.01rem) {
    .areas .lead {
      grid-column: span 2;
      grid-row: span 2;
    }

    .areas .lead .h3 {
      font-size: clamp(2rem, 3.2vw, 2.9rem);
    }

    .areas .lead p {
      max-width: 36rem;
      font-size: 1.15rem;
    }
  }

  @media (min-width: 38.01rem) and (max-width: 62rem) {
    .areas .lead {
      grid-column: 1 / -1;
    }
  }

  /* The screen lifts off a hard shadow in the area's own color. */
  .area-figure {
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .area:hover .area-figure,
  .area:focus-visible .area-figure {
    transform: translate(-6px, -6px);
    box-shadow: 6px 6px 0 var(--topic);
  }

  .area-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
  }

  .area-text p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .area-threads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .area-count {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .area-count .arrow {
    transition: transform 0.25s var(--ease);
  }

  .area:hover .area-count .arrow {
    transform: translateX(5px);
  }

  /* --- Media ---------------------------------------------------------------- */

  .record {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .record-list :global(.row) {
    grid-template-columns: minmax(0, 1fr);
  }

  .record-list :global(.where) {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .record-list :global(.chip) {
    justify-self: start;
  }

  /* --- Releases ------------------------------------------------------------- */

  .releases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .release {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 2px solid var(--text);
  }

  .release-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .release h3 a {
    background: linear-gradient(var(--maize), var(--maize)) left / 0 100% no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }

  .release h3 a:hover {
    background-size: 100% 100%;
    color: var(--blue);
  }

  .release p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* --- People --------------------------------------------------------------- */

  .people {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
    margin: 0;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  /* The student list is the tall column; the shorter blocks stack beside it. */
  .roster div:nth-child(2) {
    grid-row: span 2;
  }

  .roster dt {
    margin-bottom: 0.6rem;
  }

  .roster dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.22;
  }

  .roster .roster-note {
    margin-top: 0.35rem;
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-2);
  }

  .people-side > div {
    padding-top: 1.5rem;
  }

  .placements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  /* --- Join ----------------------------------------------------------------- */

  .join {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .join .label {
    margin-bottom: 1rem;
    color: var(--text);
  }

  .join-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: var(--rule) solid var(--text);
  }

  .join-foot .lead {
    max-width: 44rem;
  }

  /* --- Responsive ----------------------------------------------------------- */

  @media (max-width: 62rem) {
    .areas,
    .releases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }

    .people,
    .record {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 44rem) {
    .hero-foot,
    .join-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .areas,
    .releases {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-mark {
      bottom: 0.15rem;
      width: clamp(3.5rem, 19vw, 5.25rem);
    }

    .stats div {
      padding-inline: 0.9rem 0.25rem;
    }

    .cta .btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .display .line > span,
    .hero-mark,
    .hero-foot .lead,
    .cta {
      animation: none;
    }
  }
</style>
