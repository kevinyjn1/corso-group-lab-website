---
/** A live illustration of one research area or project. See src/scripts/figures.ts. */
import { FIGURES, type FigureName } from '../lib/figures';

interface Props {
  topic: FigureName;
  /** Number shown in the figure's label, as in a paper. */
  number?: number;
  /** A wide figure is shown as a 16:10 screen where there is room for one. */
  wide?: boolean;
}
const { topic, number, wide = false } = Astro.props;
const figure = FIGURES[topic];
/** Figures that tell a story in steps get a console: a live reading, and the steps to jump to. */
const steps = 'steps' in figure ? figure.steps : undefined;
const loop = 'loop' in figure ? figure.loop : undefined;
---

<figure class="figure" data-figure={topic} data-topic={topic} data-wide={wide ? '' : undefined}>
  <canvas aria-hidden="true"></canvas>
  <figcaption>
    {number !== undefined && <span class="num">Fig. {number}</span>}
    <span>{figure.title}</span>
    <span class="sr-only">{figure.alt}</span>
  </figcaption>
</figure>
{steps && (
  <div class="console" data-console data-loop={loop}>
    <p class="readout">
      <strong data-readout-value>&nbsp;</strong>
      <span data-readout-label />
    </p>
    <p class="says">
      <span class="says-who">
        <span class="bars" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        VIGIL says
      </span>
      <span class="says-what" data-says />
    </p>
    <button
      type="button"
      class="pause"
      data-pause
      aria-pressed="false"
      aria-label="Pause the animation"
    >
      <svg class="icon-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" fill="currentColor" />
      </svg>
      <svg class="icon-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M4 2.5v11l9.5-5.5z" fill="currentColor" />
      </svg>
    </button>
    <ol class="steps" aria-label="The steps of this exam. Choose one to jump to it.">
      {steps.map((step, i) => (
        <li>
          <button type="button" data-step={step.at}>
            <span class="step-n">{i + 1}</span>
            <span class="step-name">{step.name}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
)}

<script>
  import { mountFigures } from '../scripts/figures';

  mountFigures();
</script>

<style>
  .figure {
    /* Screens are dark in both themes, so they always use the bright set of area colors. */
    --topic-video: #ffcb05;
    --topic-language: #5cc8ff;
    --topic-robotics: #7be495;
    --topic-human: #ff7ab6;
    --topic-health: #ff9466;
    --topic-learning: #b79cff;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: radial-gradient(130% 90% at 50% 0%, #07264a 0%, var(--screen) 68%);
    color: var(--screen-text);
  }

  @media (min-width: 40rem) {
    .figure[data-wide] {
      aspect-ratio: 16 / 10;
    }
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
  }

  /* The label sits on the screen like the title bar of an instrument. */
  figcaption {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.65rem;
    background: var(--topic, var(--maize));
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--screen);
  }

  .num {
    padding-right: 0.6rem;
    border-right: 1.5px solid currentColor;
  }

  /* --- The console: one reading in real type, and the story's steps ---------- */

  .console {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) minmax(0, 1fr) auto;
    grid-template-areas:
      'read says pause'
      'steps steps steps';
    gap: 0.9rem clamp(0.9rem, 2vw, 1.5rem);
    align-items: center;
    padding: 0.9rem 0.9rem 0.8rem;
    background: var(--screen);
    border-top: 1px solid var(--screen-line);
    color: var(--screen-text);
  }

  .readout {
    grid-area: read;
    display: grid;
    gap: 0.3rem;
  }

  /* What the assistant is saying is the point of the figure, so it is the largest text here. */
  .says {
    grid-area: says;
    display: grid;
    align-content: center;
    gap: 0.4rem;
    min-height: 3.6rem;
    padding-left: clamp(0.9rem, 2vw, 1.5rem);
    border-left: 1px solid var(--screen-line);
  }

  .says-who {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--maize);
  }

  .says-what {
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: clamp(1.1rem, 1.9vw, 1.45rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--screen-text);
    text-wrap: balance;
  }

  /* Three bars that move while it speaks. */
  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.8rem;
  }

  .bars i {
    width: 3px;
    height: 100%;
    background: var(--maize);
    transform: scaleY(0.3);
    transform-origin: bottom;
  }

  .console[data-speaking]:not([data-held]) .bars i {
    animation: speak 0.9s ease-in-out infinite;
  }

  .console .bars i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .console .bars i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes speak {
    50% {
      transform: scaleY(1);
    }
  }

  .pause {
    grid-area: pause;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--screen-line);
    color: var(--screen-text);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .pause:hover {
    border-color: var(--maize);
    color: var(--maize);
  }

  .pause .icon-play,
  .pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .console[data-speaking] .bars i {
      animation: none;
    }
  }

  .readout strong {
    font-family: var(--font-display);
    font-stretch: 66%;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 0.82;
    font-variant-numeric: tabular-nums;
    color: var(--maize);
  }

  .readout span {
    font-size: 0.78rem;
    line-height: 1.25;
    color: var(--screen-text-2);
  }

  .steps {
    grid-area: steps;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each step is a segment of one rail. Finished steps stay lit, and the current one is full. */
  .steps button {
    display: grid;
    gap: 0.3rem;
    width: 100%;
    padding-top: 0.5rem;
    border-top: 3px solid var(--screen-line);
    font-family: var(--font-display);
    font-stretch: 90%;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-align: left;
    text-transform: uppercase;
    color: var(--screen-text-2);
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .steps button[data-done] {
    border-top-color: color-mix(in srgb, var(--maize) 45%, transparent);
  }

  .steps button[data-on] {
    border-top-color: var(--maize);
    color: var(--screen-text);
  }

  .steps button:hover {
    color: var(--maize);
  }

  .step-n {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  @media (max-width: 40rem) {
    .console {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'read pause'
        'says says'
        'steps steps';
    }

    .says {
      min-height: 3.2rem;
      padding-left: 0;
      border-left: 0;
    }

    /* On a narrow screen only the current step is named; the rest are numbers. */
    .steps button:not([data-on]) .step-name {
      display: none;
    }

    .steps {
      grid-auto-columns: auto;
      grid-template-columns: repeat(5, auto);
      justify-content: start;
      gap: 0.3rem 0.5rem;
    }

    .steps button {
      min-width: 2rem;
    }
  }
</style>
