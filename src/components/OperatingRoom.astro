---
/**
 * Surgery and the heart: four results from two decades of the group's work, oldest first, each
 * shown by a real figure from its paper. It follows the VIGIL band on the Research page, on the
 * same blue. The results are in src/lib/operating-room.ts.
 */
import { Image } from 'astro:assets';
import { paperOf, paperUrl, shortCite } from '../lib/cite';
import { getPublications } from '../lib/content';
import { OPERATING_ROOM } from '../lib/operating-room';

const publications = await getPublications();
const operatingRoom = OPERATING_ROOM.map((result) => {
  const pub = paperOf(publications, result.paper, 'Operating room');
  return { ...result, source: `${result.figure} of ${shortCite(pub)}`, href: paperUrl(pub) };
});
---

<section class="stage band--blue" id="operating-room">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="label">In the operating room</p>
        <h2 class="h2">
          Surgery and the heart, since <em>2004</em>.
        </h2>
        <p>
          Two decades of work by Prof. Corso and the group, in four results as their papers show
          them.
        </p>
      </div>
    </div>
    <ol class="results" data-reveal="stagger">
      {operatingRoom.map((result) => (
        <li class="result" data-result={result.id}>
          <div class="result-sheet">
            <Image
              src={result.image}
              alt={result.alt}
              widths={[320, 480, 640, 960].filter((width) => width <= result.image.width)}
              sizes="(min-width: 62rem) 18rem, (min-width: 38rem) 44vw, 92vw"
              quality={84}
            />
          </div>
          <h3 class="result-name">
            <span class="result-year">{result.year}</span>
            {result.name}
          </h3>
          <p class="result-what">{result.what}</p>
          <p class="result-source">
            {result.href ? (
              <a href={result.href} rel="noopener">
                {result.source}&nbsp;<span aria-hidden="true">&nearr;</span>
              </a>
            ) : (
              result.source
            )}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stage {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  /* The operating room follows the VIGIL band on the same blue. It leaves out the corner light
     that a blue band opens with, so the two meet as one field, with no edge between them. */
  :global(section.vigil) + .stage {
    padding-top: 0;
    background:
      linear-gradient(100deg, var(--band) 28%, transparent 88%),
      radial-gradient(circle at center, rgb(255 255 255 / 0.11) 1px, transparent 1.6px) 0 0 / 16px
        16px,
      var(--band);
  }

  .stage .section-head {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Four results, oldest first: each a real figure on its white sheet, and what it shows. */
  .results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1.25rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Every sheet is the same shape, and each figure is fitted inside it whole. */
  .result-sheet {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #fff;
  }

  .result-sheet img {
    position: absolute;
    inset: 0.6rem;
    width: calc(100% - 1.2rem);
    height: calc(100% - 1.2rem);
    object-fit: contain;
  }

  .result-name {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .result-year {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--maize);
  }

  .result-what {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .result-source {
    margin-top: 0.8rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--text-2);
  }

  .result-source a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  .result-source a:hover {
    text-decoration-color: var(--maize);
  }

  @media (max-width: 62rem) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .results {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
