---
import Logo from './Logo.astro';
import { site, nav, href } from '../lib/site';

const year = new Date().getFullYear();
const [user, domain] = site.email.split('@');
const external = [
  { label: 'GitHub', href: site.links.github },
  { label: 'Google Scholar', href: site.links.scholar },
  { label: 'Voxel51', href: site.links.voxel51 },
  { label: 'Essays', href: site.links.essays },
];
const michigan = [
  { label: 'Michigan Robotics', href: site.links.robotics },
  { label: 'Michigan EECS', href: site.links.eecs },
  { label: 'Previous website', href: site.links.legacy },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <a class="brand" href={href('/')} aria-label={`${site.name} home`}>
          <Logo size={30} />
          <span class="brand-mark">{site.mark}</span>
        </a>
        <p>
          The {site.name} at the {site.university}. Computer vision, language, and robotics for the
          physical world.
        </p>
        <p class="contact">
          <a class="link" href={`mailto:${user}@${domain}`} data-email>
            {user}
            <span>@</span>
            {domain}
          </a>
          <span>{site.location}</span>
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="label">Site</h2>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={href(item.path)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="label">Elsewhere</h2>
        <ul>
          {external.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="label">Michigan</h2>
        <ul>
          {michigan.map((item) => (
            <li>
              <a href={item.href} rel="noopener">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="bottom">
      <p>
        &copy; {year} {site.name}, {site.university}
      </p>
      <p class="mono">42.2936&deg; N, 83.7166&deg; W</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    font-size: 0.925rem;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) repeat(3, minmax(0, 1fr));
    gap: 3rem 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-mark {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .about p {
    max-width: 24rem;
    margin-top: 1.25rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .about .contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .about .contact .link {
    align-self: flex-start;
  }

  h2 {
    margin-bottom: 1.1rem;
  }

  li + li {
    margin-top: 0.55rem;
  }

  li a {
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  li a:hover {
    color: var(--text);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .mono {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 52rem) {
    .top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34rem) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
