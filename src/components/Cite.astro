---
/** Numbered references to the sources listed at the foot of the VIGIL page. */
import { SOURCES, type SourceId } from '../lib/vigil';

interface Props {
  ids: readonly SourceId[];
}
const { ids } = Astro.props;
const order = Object.keys(SOURCES) as SourceId[];
---

<sup class="cite">
  {ids.map((id) => (
    <a href={`#source-${id}`} aria-label={`Source: ${SOURCES[id].label}`}>
      {order.indexOf(id) + 1}
    </a>
  ))}
</sup>

<style>
  .cite {
    display: inline-flex;
    gap: 0.3em;
    margin-left: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 600;
    line-height: 1;
    vertical-align: super;
  }

  a {
    padding: 0.1em 0.3em;
    border: 1px solid var(--line-2);
    color: var(--text-2);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  a:hover {
    background: var(--maize);
    border-color: var(--maize);
    color: var(--on-maize);
  }
</style>
