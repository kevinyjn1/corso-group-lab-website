---
import { getPublications } from '../lib/content';

/** A slow ticker of the venues the group publishes in most, with paper counts. */
const publications = await getPublications();
const counts = new Map<string, number>();
for (const pub of publications) {
  if (!pub.data.venueShort || !['conference', 'journal'].includes(pub.data.type)) continue;
  counts.set(pub.data.venueShort, (counts.get(pub.data.venueShort) ?? 0) + 1);
}
const venues = [...counts.entries()]
  .filter(([, count]) => count >= 3)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<div class="ticker band--maize">
  <p class="label">Published at</p>
  <div class="window">
    <div class="track">
      {[false, true].map((duplicate) => (
        <ul aria-hidden={duplicate ? 'true' : undefined}>
          {venues.map(([name, count]) => (
            <li>
              <span class="name">{name}</span>
              <span class="count">
                <span class="sr-only">, </span>
                {count}
                <span class="sr-only"> papers</span>
              </span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    border-block: var(--rule) solid var(--blue);
  }

  .label {
    display: flex;
    align-items: center;
    padding-inline: var(--gutter) 1.25rem;
    background: var(--blue);
    color: var(--maize);
    white-space: nowrap;
  }

  /* Positioned, so that the strip's screen-reader text is clipped with the rest of it. Without
     this, that text is placed against the page and makes the whole page scroll sideways whenever
     the strip is not moving. */
  .window {
    position: relative;
    overflow: hidden;
    padding-block: 0.55rem 0.4rem;
  }

  .track {
    display: flex;
    width: max-content;
    animation: ticker 60s linear infinite;
  }

  .window:hover .track {
    animation-play-state: paused;
  }

  ul {
    display: flex;
    flex: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
    white-space: nowrap;
  }

  .name {
    font-family: var(--font-display);
    font-stretch: 70%;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* Held still, the strip shows one copy of the list, and can be scrolled by hand. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }

    .window {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--blue) transparent;
    }

    ul[aria-hidden='true'] {
      display: none;
    }

    ul {
      padding-right: var(--gutter);
    }
  }

  @media (max-width: 40rem) {
    .label {
      padding-inline: var(--gutter) 0.75rem;
    }
  }
</style>
