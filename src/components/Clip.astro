---
/**
 * A short, silent clip of the group's own footage, shown like a figure in a paper.
 *
 * It loops only while it is on screen, it can always be paused, and it does not start on its own
 * for visitors who ask for reduced motion. The caption is the slot. See src/scripts/clips.ts.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The clip, imported from src/assets/clips. */
  src: string;
  /** Its first telling frame, shown until the clip plays. */
  poster: ImageMetadata;
  /** What the clip shows, for people who cannot see it. */
  alt: string;
  /** The tag in the corner: where the footage is from. */
  tag?: string;
  /** Which bottom corner holds the pause button. Use the left when the right one has something to read. */
  toggle?: 'left' | 'right';
}
const { src, poster, alt, tag = 'Footage', toggle = 'right' } = Astro.props;
const still = await getImage({ src: poster, width: poster.width, format: 'webp', quality: 72 });
---

<figure class="clip" data-clip>
  <div
    class="clip-frame"
    data-toggle={toggle}
    style={`aspect-ratio: ${poster.width} / ${poster.height}`}
  >
    <video
      muted
      loop
      playsinline
      preload="none"
      poster={still.src}
      width={poster.width}
      height={poster.height}
      aria-label={alt}
    >
      <source src={src} type="video/mp4" />
    </video>
    <p class="clip-tag">{tag}</p>
    <button
      type="button"
      class="clip-toggle"
      data-clip-toggle
      aria-pressed="true"
      aria-label="Play the clip"
    >
      <svg class="icon-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" fill="currentColor"></path>
      </svg>
      <svg class="icon-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M4 2.5v11l9.5-5.5z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
  <figcaption>
    <slot />
  </figcaption>
</figure>

<script>
  import { mountClips } from '../scripts/clips';

  mountClips();
</script>

<style>
  .clip {
    margin: 0;
  }

  .clip-frame {
    position: relative;
    overflow: hidden;
    background: var(--screen);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The tag says what kind of picture this is, as a figure's label does. */
  .clip-tag {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.4rem 0.6rem;
    background: var(--maize);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }

  .clip-toggle {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid rgb(255 255 255 / 0.55);
    background: rgb(0 20 43 / 0.72);
    color: #fff;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .clip-frame[data-toggle='left'] .clip-toggle {
    right: auto;
    left: 0.6rem;
  }

  .clip-toggle:hover {
    border-color: var(--maize);
    background: rgb(0 20 43 / 0.92);
  }

  .clip-toggle:focus-visible {
    outline: 2px solid var(--maize);
    outline-offset: 2px;
  }

  /* Pressed means held still: the button then offers to play. */
  .clip-toggle .icon-pause,
  .clip-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  .clip-toggle .icon-play,
  .clip-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }

  figcaption {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  figcaption :global(strong) {
    color: var(--text);
  }
</style>
