---
/**
 * A video with its thumbnail. Pressing play swaps the thumbnail for the player, so nothing is
 * loaded from the video host until a visitor asks for it. The title always links to the source.
 */
import { Image } from 'astro:assets';
import { formatDate, type MediaItem } from '../lib/content';
import { thumbnail } from '../lib/thumbnails';

interface Props {
  item: MediaItem;
  /** How wide the card is shown, for choosing an image size. */
  sizes?: string;
}

const { item, sizes = '(min-width: 62rem) 40vw, 92vw' } = Astro.props;
const { title, outlet, date, url, youtubeId, summary } = item.data;
const thumb = thumbnail(youtubeId);
---

<article class="video">
  {thumb && (
    <div class="frame" data-video={youtubeId}>
      <button class="thumb" type="button" aria-label={`Play video: ${title}`}>
        <Image src={thumb} alt="" widths={[480, 800, 1280]} sizes={sizes} quality={74} />
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28">
            <path d="M7 4.5v15l12.5-7.5z" fill="currentColor" />
          </svg>
        </span>
      </button>
    </div>
  )}
  <div class="meta">
    <p class="label where">
      <span>{outlet}</span>
      {date && <span class="when">{formatDate(date)}</span>}
    </p>
    <h3 class="h3">
      <a href={url} rel="noopener">
        {title}&nbsp;<span aria-hidden="true">&nearr;</span>
      </a>
    </h3>
    {summary && <p class="summary">{summary}</p>}
  </div>
</article>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const button = frame.querySelector('button');
    button?.addEventListener('click', () => {
      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`;
      player.title = button.getAttribute('aria-label')?.replace('Play video: ', '') ?? 'Video';
      player.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      player.allowFullscreen = true;
      frame.replaceChildren(player);
      frame.dataset.playing = '';
    });
  }
</script>

<style>
  .video {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--screen);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .frame:not([data-playing]):hover {
    transform: translate(-6px, -6px);
    box-shadow: 6px 6px 0 var(--maize);
  }

  .thumb,
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A square maize play button, in the corner like a label. */
  /* Bottom right: the corner that video covers leave clear for the player's own duration badge. */
  .play {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: clamp(3rem, 6vw, 4.25rem);
    aspect-ratio: 1;
    background: var(--maize);
    color: var(--blue);
    transition: width 0.25s var(--ease-out);
  }

  .thumb:hover .play,
  .thumb:focus-visible .play {
    width: clamp(3.75rem, 7.5vw, 5.25rem);
  }

  /* Where it appeared and when, set as the rows of a list set them: no dot between the two, so
     that a date that wraps never starts its line with one. */
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.75rem;
  }

  .when {
    white-space: nowrap;
    opacity: 0.72;
  }

  .h3 {
    margin-top: 0.5rem;
  }

  .h3 a {
    background: linear-gradient(var(--maize), var(--maize)) left / 0 100% no-repeat;
    transition:
      background-size 0.3s var(--ease-out),
      color 0.2s var(--ease);
  }

  .h3 a:hover {
    background-size: 100% 100%;
    color: var(--blue);
  }

  .h3 span {
    font-size: 0.7em;
    font-weight: 500;
  }

  .summary {
    margin-top: 0.6rem;
    color: var(--text-2);
    text-wrap: pretty;
  }
</style>
