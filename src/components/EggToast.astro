---
/**
 * The pop-up that greets a visitor who has just found the hidden game for the first time.
 * See src/scripts/easter-egg.ts.
 */
import Logo from './Logo.astro';
import { href } from '../lib/site';
---

<div class="egg band--maize" data-egg-toast hidden role="status">
  <span class="sparks" aria-hidden="true">
    {Array.from({ length: 10 }, (_, i) => (
      <i style={`--n: ${i}`} />
    ))}
  </span>
  <Logo size={56} tile />
  <div class="words">
    <p class="title">Easter egg unlocked</p>
    <p class="note">You found Ground Truth, the group's hidden game.</p>
  </div>
  <a class="btn btn--primary" href={href('/play/')}>
    Play{' '}
    <span class="arrow" aria-hidden="true">
      &rarr;
    </span>
  </a>
  <button class="close" type="button" data-egg-close aria-label="Dismiss">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>
</div>

<style>
  .egg {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.85rem 2.6rem 0.85rem 0.85rem;
    border: var(--rule) solid var(--blue);
    box-shadow: 6px 6px 0 var(--blue);
    animation: egg-in 0.7s var(--ease-out) both;
  }

  .egg[data-leaving] {
    animation: egg-out 0.35s var(--ease) both;
  }

  .title {
    font-family: var(--font-display);
    font-stretch: 70%;
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .note {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .btn {
    height: 2.6rem;
    padding-inline: 1rem;
  }

  .close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--blue);
  }

  .close:hover {
    background: var(--blue);
    color: var(--maize);
  }

  /* A burst of little squares from behind the card as it lands. */
  .sparks {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
  }

  .sparks i {
    --turn: calc(var(--n) * 36deg);
    position: absolute;
    width: 0.6rem;
    height: 0.6rem;
    background: var(--blue);
    animation: spark 0.9s var(--ease-out) 0.15s both;
  }

  .sparks i:nth-child(odd) {
    background: var(--maize);
    outline: 2px solid var(--blue);
  }

  @keyframes egg-in {
    0% {
      opacity: 0;
      transform: translateY(120%) rotate(4deg);
    }
    60% {
      opacity: 1;
      transform: translateY(-6%) rotate(-1deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes egg-out {
    to {
      opacity: 0;
      transform: translateY(40%);
    }
  }

  @keyframes spark {
    from {
      opacity: 1;
      transform: rotate(var(--turn)) translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: rotate(var(--turn)) translateY(-9rem) scale(0.4);
    }
  }

  @media (max-width: 36rem) {
    .egg {
      left: 0.75rem;
      flex-wrap: wrap;
    }

    .title {
      font-size: 1.35rem;
    }

    .btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .egg,
    .egg[data-leaving] {
      animation: none;
    }

    .sparks {
      display: none;
    }
  }
</style>
