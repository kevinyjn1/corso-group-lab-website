---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A framed portrait. If src/assets/people/ holds an image named after the person's id
 * (for example jason-corso.jpg), it is used; otherwise the person's initials are shown.
 */
interface Props {
  /** The person's id: the name of their file in the content's people/ folder. */
  id?: string;
  name: string;
  size?: 'large' | 'small';
  /** Text shown in place of initials, for placeholder cards. */
  mark?: string;
  muted?: boolean;
}

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/people/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photos = new Map(
  Object.entries(files).map(([path, file]) => [
    path
      .split('/')
      .pop()!
      .replace(/\.[^.]+$/, ''),
    file.default,
  ]),
);

const { id, name, size = 'small', mark, muted = false } = Astro.props;
const photo = id ? photos.get(id) : undefined;
const initials = name
  .split(' ')
  .filter((part) => /^[A-Z][a-z]/.test(part))
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<div class:list={['portrait', `portrait--${size}`, 'ticks', { 'portrait--muted': muted }]}>
  {photo ? (
    <Image
      src={photo}
      alt={`Portrait of ${name}`}
      widths={size === 'large' ? [160, 320, 500] : [72, 144, 216]}
      sizes={size === 'large' ? '(max-width: 48rem) 9rem, 20rem' : '4.5rem'}
      quality={82}
    />
  ) : (
    <div class="initials" aria-hidden="true">
      <span>{mark ?? initials}</span>
    </div>
  )}
</div>

<style>
  /* The corner ticks frame the picture like a detection box, with a little air around it. */
  .portrait {
    --tick-color: var(--accent);
  }

  .portrait--large {
    --tick: 1rem;
    padding: 0.625rem;
  }

  .portrait--small {
    --tick: 0.5rem;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0.3rem;
  }

  .portrait--muted {
    --tick-color: var(--line-2);
  }

  .portrait :global(img),
  .initials {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait :global(img) {
    object-fit: cover;
    /* Faces sit in the upper part of most portraits. */
    object-position: 50% 20%;
    background: var(--bg-2);
  }

  .portrait--large :global(img),
  .portrait--large .initials {
    height: auto;
    aspect-ratio: 4 / 5;
  }

  .initials {
    position: relative;
    display: grid;
    place-items: center;
    background: var(--bg-2);
    font-family: var(--font-display);
    font-stretch: 70%;
    font-weight: 800;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--text);
  }

  .portrait--large .initials {
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    letter-spacing: -0.03em;
  }

  /* Dot matrix behind large initials, echoing the home page scene. */
  .portrait--large .initials::before {
    content: '';
    position: absolute;
    inset: 1rem;
    background: radial-gradient(circle, var(--line-2) 1px, transparent 1.5px) center / 0.75rem
      0.75rem;
    mask-image: radial-gradient(circle at center, transparent 30%, #000 75%);
  }

  .initials span {
    position: relative;
  }

  .portrait--muted .initials {
    background: transparent;
    color: var(--text-3);
  }
</style>
