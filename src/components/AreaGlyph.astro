---
import type { Topic } from '../lib/content';

/** A small line drawing for each research area, in that area's color. */
interface Props {
  topic: Topic;
  size?: number;
}

const { topic, size = 56 } = Astro.props;
---

<svg
  class="glyph"
  data-topic={topic}
  viewBox="0 0 56 56"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  focusable="false"
>
  {topic === 'video' && (
    <>
      <path d="M17.5 14.5h28v22M11.5 20.5h28v22" opacity="0.45" />
      <rect x="5.5" y="26.5" width="28" height="22" />
      <rect class="fill" x="13" y="33" width="8" height="9" stroke="none" />
    </>
  )}
  {topic === 'language' && (
    <>
      <path d="M5.5 9.5h45v28h-27l-9 9v-9h-9z" />
      <path class="accent" d="M13 19h30M13 27h18" stroke-width="2.5" />
    </>
  )}
  {topic === 'robotics' && (
    <>
      <path
        d="M8 46c8-2 10-12 18-14s8-14 20-16"
        class="dash"
        stroke-dasharray="3 4"
        opacity="0.6"
      />
      <rect class="fill" x="4.5" y="42.5" width="7" height="7" stroke="none" />
      <rect x="22.5" y="28.5" width="7" height="7" />
      <path class="accent" d="M39 9.5h11.5V21" stroke-width="2.5" />
    </>
  )}
  {topic === 'human' && (
    <>
      <circle cx="21" cy="28" r="14.5" />
      <rect x="24.5" y="13.5" width="26" height="29" opacity="0.55" />
      <path class="fill" d="M24.5 17.3a14.5 14.5 0 0 1 0 21.4z" stroke="none" />
    </>
  )}
  {topic === 'health' && (
    <>
      <rect x="5.5" y="5.5" width="45" height="45" opacity="0.45" />
      <path
        class="accent"
        d="M5.5 30h11l4-11 7 22 5-15 3 4h15"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    </>
  )}
  {topic === 'learning' && (
    <>
      <path d="M11 12 28 28 11 44M45 12 28 28l17 16M11 12h34M11 44h34" opacity="0.5" />
      <rect x="7.5" y="8.5" width="7" height="7" fill="var(--bg)" />
      <rect x="41.5" y="8.5" width="7" height="7" fill="var(--bg)" />
      <rect x="7.5" y="40.5" width="7" height="7" fill="var(--bg)" />
      <rect x="41.5" y="40.5" width="7" height="7" fill="var(--bg)" />
      <rect class="fill" x="23.5" y="23.5" width="9" height="9" stroke="none" />
    </>
  )}
</svg>

<style>
  .glyph {
    flex: none;
    color: var(--text-2);
    overflow: visible;
  }

  .glyph .fill {
    fill: var(--topic);
  }

  .glyph .accent {
    stroke: var(--topic);
  }

  .glyph .fill {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Each glyph comes alive when its card is hovered. */
  :global(a:hover) .glyph[data-topic='video'] .fill {
    animation: glyph-shift 0.9s var(--ease) infinite alternate;
  }

  :global(a:hover) .glyph[data-topic='language'] .accent,
  :global(a:hover) .glyph[data-topic='health'] .accent {
    stroke-dasharray: 90;
    animation: glyph-draw 1.3s var(--ease) infinite;
  }

  :global(a:hover) .glyph[data-topic='robotics'] .dash {
    animation: glyph-march 0.7s linear infinite;
  }

  :global(a:hover) .glyph[data-topic='human'] .fill,
  :global(a:hover) .glyph[data-topic='learning'] .fill {
    animation: glyph-pulse 0.8s var(--ease) infinite alternate;
  }

  @keyframes glyph-shift {
    to {
      transform: translateX(11px);
    }
  }

  @keyframes glyph-draw {
    from {
      stroke-dashoffset: 90;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes glyph-march {
    to {
      stroke-dashoffset: -14;
    }
  }

  @keyframes glyph-pulse {
    from {
      transform: scale(0.6);
      opacity: 0.6;
    }
    to {
      transform: scale(1.25);
      opacity: 1;
    }
  }
</style>
