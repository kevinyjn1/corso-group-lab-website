---
/** VIGIL's full name, with the letters that spell the acronym marked. */
import { vigil } from '../lib/vigil';

interface Props {
  /** Set where the full name is already given in words, so it is not read out twice. */
  decorative?: boolean;
}
const { decorative = false } = Astro.props;
---

<p class="vigil-name" aria-hidden={decorative ? 'true' : undefined}>
  {!decorative && <span class="sr-only">{vigil.fullName}</span>}
  {vigil.expansion.map(([initial, rest]) => (
    <span class="word" aria-hidden="true">
      <b>{initial}</b>
      {rest}
    </span>
  ))}
</p>

<style>
  .vigil-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 0.5em;
    max-width: 32rem;
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: clamp(1.05rem, 1.55vw, 1.35rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .word {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  /* Each initial is set as a small block of the marking color. */
  b {
    margin-right: 0.07em;
    padding: 0.02em 0.16em 0.02em 0.2em;
    background: var(--mark, var(--maize));
    font-weight: 800;
    text-align: center;
    color: var(--on-mark, var(--blue));
  }
</style>
