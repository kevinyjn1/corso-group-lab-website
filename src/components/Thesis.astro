---
/**
 * The group's thesis on the home page: what an AI must do to guide a person, the first two of the
 * talk's three claims with a live figure each, and how the group got here. The third claim is the
 * VIGIL band that follows. The words are in src/lib/thesis.ts.
 */
import { Image } from 'astro:assets';
import Clip from './Clip.astro';
import millyLapse from '../assets/clips/milly-lapse.mp4';
import mistakeResults from '../assets/clips/mistake-results-wide.mp4';
import millyPoster from '../assets/clips/posters/milly-lapse.jpg';
import mistakePoster from '../assets/clips/posters/mistake-results-wide.jpg';
import hazyCombined from '../assets/papers/hazy-combined.png';
import hazyFirst from '../assets/papers/hazy-request-1.png';
import hazySecond from '../assets/papers/hazy-request-2.png';
import { getPublications } from '../lib/content';
import { thesis } from '../lib/thesis';

const publications = await getPublications();
const papersOf = (ids: readonly string[]) =>
  ids.flatMap((id) => publications.filter((pub) => pub.id === id));
const shown = thesis.claims.filter((claim) => claim.figure);
/** The real example shown under the first claim, and the paper it is from. */
const resultPaper = papersOf(['lemmer2023evaluating'])[0];
const RESULT_SOURCE = {
  label: 'Figure 4 of Lemmer and Corso, AAAI 2023',
  href: resultPaper.data.links?.arxiv ?? resultPaper.data.links?.doi,
};
---

<section class="section thesis" id="thesis">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="label">The thesis</p>
        <h2 class="h2">
          Understand the task. Understand the <em>human</em>. Fill the gap.
        </h2>
        <p>That is what an AI must do to guide a person. Three things follow from it.</p>
      </div>
    </div>

    <ol class="claims" data-reveal="stagger">
      {shown.map((claim, i) => (
        <li class="claim">
          <p class="claim-quote">
            <span class="claim-n">{String(i + 1).padStart(2, '0')}</span>
            It {claim.quote}
          </p>
          <h3 class="h3">{claim.title}</h3>
          <div class="claim-figure">
            {claim.figure === 'oracle' ? (
              <figure class="result" data-result>
                <div class="result-grid">
                  <div class="result-panel">
                    <Image
                      src={hazyFirst}
                      alt="A row of glass vases on a table outdoors. A red box around the third vase is labeled 84%, and a blue box around the second vase is labeled 16%."
                      widths={[320, 480, 868]}
                      sizes="(min-width: 62rem) 18rem, 46vw"
                      quality={82}
                    />
                    <p>
                      <span class="result-n">1</span> "third vase from left"
                    </p>
                  </div>
                  <div class="result-panel">
                    <Image
                      src={hazySecond}
                      alt="The same vases. A red box around the first vase is labeled 87%, and a blue box around the second vase is labeled 13%."
                      widths={[320, 480, 868]}
                      sizes="(min-width: 62rem) 18rem, 46vw"
                      quality={82}
                    />
                    <p>
                      <span class="result-n">2</span> "left vase from cylinder"
                    </p>
                  </div>
                  <div class="result-panel result-answer">
                    <Image
                      src={hazyCombined}
                      alt="The same vases. Only the second vase is boxed, in blue, labeled 99%."
                      widths={[320, 480, 868]}
                      sizes="(min-width: 62rem) 18rem, 46vw"
                      quality={82}
                    />
                    <p>
                      <span class="result-n">1 + 2</span> Both answers, combined
                    </p>
                  </div>
                  <p class="result-take">Neither description finds the vase. Together they do.</p>
                </div>
                <figcaption>
                  <strong>Asking twice, on a real photograph.</strong> Given one description of a
                  vase, the model puts 84% on the wrong one (red). Given a second, it puts 87% on
                  another. Combined, the two answers put 99% on the vase that was meant (blue).{' '}
                  <a class="result-source" href={RESULT_SOURCE.href} rel="noopener">
                    {RESULT_SOURCE.label}
                  </a>
                </figcaption>
              </figure>
            ) : (
              <Clip
                src={mistakeResults}
                poster={mistakePoster}
                tag="Model output"
                toggle="top"
                alt="Four first-person video clips of people doing household tasks, each over an instruction such as: picks the scraper, moves the bowl, places the bottle. As each attempt goes wrong, the clip stops, a colored heat map and a red box mark a region of the frame, the word Detected appears, and the words of the instruction turn red or green with a cross or a check."
              >
                <strong>The model on real first-person video.</strong> When it detects a mistake, it
                marks where in the frame (the box), when (the time under the clip), and which part
                of the instruction was not followed: the action, the object, or both (red). The
                videos are from public research datasets.{' '}
                <a class="result-source" href="https://yayuanli.github.io/MATT/" rel="noopener">
                  From the group's video of the CVPR 2026 paper
                </a>
              </Clip>
            )}
          </div>
          <p class="claim-body">{claim.body}</p>
          <ul class="claim-papers">
            {papersOf(claim.papers).map((pub) => (
              <li>
                <a href={pub.data.links?.arxiv ?? pub.data.links?.doi} rel="noopener">
                  {pub.data.title}&nbsp;<span aria-hidden="true">&nearr;</span>
                </a>
                <span class="venue">
                  {pub.data.venueShort ?? pub.data.venue} {pub.data.year}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="arc-head" data-reveal>
      <p class="label">How the group got here</p>
    </div>
    <div class="arc-wrap" data-reveal="stagger">
      {[thesis.arc.slice(0, 2), thesis.arc.slice(2, -1)].map((steps, column) => (
        <ol class="arc" start={column * 2 + 1}>
          {steps.map((step) => (
            <li>
              <p class="arc-when">{step.when}</p>
              <div>
                <h3>{step.title}</h3>
                <p class="arc-body">{step.body}</p>
                {papersOf('papers' in step ? step.papers : []).map((pub) => (
                  <p class="arc-paper">
                    <a href={pub.data.links?.arxiv ?? pub.data.links?.doi} rel="noopener">
                      {pub.data.title}&nbsp;<span aria-hidden="true">&nearr;</span>
                    </a>
                    <span class="venue">
                      {pub.data.venueShort ?? pub.data.venue} {pub.data.year}
                    </span>
                  </p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      ))}
      <Clip
        src={millyLapse}
        poster={millyPoster}
        tag="Footage · MILLY"
        alt="A person at a lab bench starts making coffee while a monitor shows the camera's view and the recipe. A caption reads: 1. Measure 12 ounces of cold water. Then a caption appears: Mistake! Step 4 (weigh beans) detected. Expecting step 2 (assemble cone)."
      >
        <strong>MILLY, catching a skipped step.</strong> A person makes coffee while the system
        follows the recipe. When they weigh the beans before assembling the cone, it flags the
        lapse.
      </Clip>
      {thesis.arc.slice(-1).map((step) => (
        <ol class="arc arc--last" start={thesis.arc.length}>
          <li>
            <p class="arc-when">{step.when}</p>
            <h3>{step.title}</h3>
            <p class="arc-body">{step.body}</p>
          </li>
        </ol>
      ))}
    </div>
  </div>
</section>

<style>
  .thesis {
    scroll-margin-top: var(--header-h);
  }

  /* Two claims side by side. Each has the same six parts (its words, its title, its picture, the
     caption, the text, the papers), and the same part of each sits on the same line, so the two
     columns start and end together and neither leaves a hole beside the other. */
  .claims {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(6, auto);
    column-gap: clamp(1.5rem, 3.5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .claim,
  .claim-figure,
  .claim-figure > :global(figure) {
    display: grid;
    grid-template-rows: subgrid;
  }

  .claim {
    grid-row: span 6;
  }

  /* The picture and its caption take the third and fourth lines. */
  .claim-figure,
  .claim-figure > :global(figure) {
    grid-row: span 2;
    min-width: 0;
  }

  /* The claim in the talk's own words, numbered like a proposition. */
  .claim-quote {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .claim-n {
    flex: none;
    padding: 0.15rem 0.4rem;
    background: var(--blue);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--maize);
  }

  .claim .h3 {
    margin-top: 0.7rem;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    text-wrap: balance;
  }

  .claim-figure {
    margin-top: 1.25rem;
  }

  /* A result from the paper, laid out as the paper lays it out: the two requests above, and
     what the group's method makes of them below. The pictures are the paper's own. */
  .result {
    margin: 0;
  }

  /* On a white sheet with a rule, as the clip beside it is, and as tall as that clip. */
  .result-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 0.9rem;
    align-content: space-evenly;
    padding: clamp(0.7rem, 1.4vw, 1rem);
    background: #fff;
    border: var(--rule) solid var(--blue);
    color: var(--blue);
  }

  /* What the three pictures add up to, in the cell beside the answer. */
  .result-take {
    align-self: start;
    padding: 0.2rem 0 0 0.9rem;
    border-left: var(--rule) solid var(--maize);
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    font-weight: 700;
    line-height: 1.2;
    text-wrap: balance;
  }

  .result-panel :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .result-panel p {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: inherit;
  }

  .result-answer p {
    font-weight: 600;
  }

  .result-n {
    flex: none;
    padding: 0.12rem 0.4rem;
    background: var(--blue);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--maize);
  }

  .result figcaption,
  .claim-figure :global(.clip figcaption) {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .result figcaption strong {
    color: var(--text);
  }

  .result-source,
  .claim-figure :global(.result-source) {
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .result-source:hover,
  .claim-figure :global(.result-source:hover) {
    text-decoration-color: var(--maize);
  }

  /* The clip of results has a white ground of its own, so it gets a rule to stand on the page.
     Where the picture beside it is the taller one, the frame grows to that height and the clip
     sits whole in the middle of it. */
  .claim-figure :global(.clip-frame) {
    align-self: stretch;
    justify-self: stretch;
    border: var(--rule) solid var(--text);
    background: #fff;
  }

  .claim-figure :global(.clip-frame video) {
    object-fit: contain;
  }

  .claim-body {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .claim-papers {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-2);
  }

  .claim-papers li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.5rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .claim-papers a:hover,
  .arc-paper a:hover {
    background: color-mix(in srgb, var(--maize) 45%, transparent);
  }

  .venue {
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-3);
  }

  /* --- The arc: four steps, the last of which is the band that follows. ------- */

  .arc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1rem;
    border-top: var(--rule) solid var(--text);
  }

  /* Three even columns: the first two steps, the last two, and the one that was filmed, MILLY
     at work. A single list of four beside the clip ran far longer than the clip. */
  .arc-wrap {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3.5vw, 3.5rem);
    align-items: start;
    margin-top: 1.5rem;
  }

  .arc {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arc li {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line-2);
  }

  .arc li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  /* The last step of all is the band that follows this section, so it closes the three columns
     as one line across them, under a maize rule. */
  .arc--last {
    grid-column: 1 / -1;
  }

  .arc--last li:first-child {
    grid-template-columns: 4.75rem auto minmax(0, 1fr);
    gap: 0.3rem 1rem;
    padding-top: 0.9rem;
    border-top: var(--rule) solid var(--maize);
  }

  .arc--last .arc-body {
    margin-top: 0;
  }

  .arc-when {
    font-family: var(--font-display);
    font-stretch: 70%;
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    font-weight: 800;
    line-height: 1;
  }

  .arc h3 {
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .arc-body {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* The paper behind a step, where the step reports a result. */
  .arc-paper {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  /* With room for it, a paper's venue stays at the right of its row, whatever the title's length. */
  @media (min-width: 62rem) {
    .claim-papers li {
      flex-wrap: nowrap;
    }
  }

  /* On a small laptop three columns are too narrow to read. There are two: the dated steps on
     the left, and the clip with the last step under it on the right. The two sides share their
     rows, so they end on the same line. */
  @media (min-width: 62.01rem) and (max-width: 78rem) {
    .arc-wrap {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: repeat(3, auto);
      row-gap: 0;
    }

    .arc:first-child {
      grid-area: 1 / 1 / 2 / 2;
    }

    .arc:nth-child(2) {
      grid-area: 2 / 1 / 4 / 2;
    }

    .arc:nth-child(2) li:first-child {
      padding-top: 0.9rem;
      border-top: 1px solid var(--line-2);
    }

    .arc-wrap > :global(.clip) {
      grid-area: 1 / 2 / 3 / 3;
    }

    .arc--last {
      grid-area: 3 / 2 / 4 / 3;
      align-self: end;
      margin-top: 1.5rem;
    }

    .arc--last li:first-child {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      padding-bottom: 0;
    }

    .arc--last h3,
    .arc--last .arc-body {
      grid-column: 2;
    }
  }

  @media (max-width: 62rem) {
    /* One column: each claim is read whole, one after the other. */
    .claims {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 3rem;
    }

    .claim,
    .claim-figure,
    .claim-figure > :global(figure) {
      display: block;
      grid-row: auto;
    }

    .arc-wrap {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }

    /* The parts of the list read as one again. */
    .arc + .arc li:first-child {
      padding-top: 0.9rem;
      border-top: 1px solid var(--line-2);
    }

    .arc--last li:first-child {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      border-top: var(--rule) solid var(--maize);
    }

    .arc--last h3,
    .arc--last .arc-body {
      grid-column: 2;
    }

    .arc--last {
      margin-top: 2rem;
    }

    .arc-wrap > :global(.clip) {
      margin-top: 2rem;
    }
  }
</style>
