---
import Logo from './Logo.astro';
import { site, nav, href, isActive } from '../lib/site';

const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={href('/')} aria-label={`${site.name} home`}>
      <Logo />
      <span class="brand-mark">{site.mark}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={href(item.path)}
              aria-current={isActive(current, item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color theme">
        <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle
            cx="10"
            cy="10"
            r="3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.75 1.75M14.25 14.25 16 16M16 4l-1.75 1.75M5.75 14.25 4 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path
            d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-btn"
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path class="line-a" d="M2 6.5h16" stroke="currentColor" stroke-width="1.5"></path>
          <path class="line-b" d="M2 13.5h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        {nav.map((item, i) => (
          <li>
            <a
              href={href(item.path)}
              aria-current={isActive(current, item.path) ? 'page' : undefined}
            >
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;

  document
    .querySelector<HTMLButtonElement>('[data-theme-toggle]')
    ?.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
    });

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  function setMenu(open: boolean) {
    if (!header || !toggle || !menu) return;
    header.toggleAttribute('data-open', open);
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    root.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  // Leaving the mobile layout closes the menu so the page is never left scroll-locked.
  window.matchMedia('(min-width: 60rem)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }

  .site-header[data-open] {
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    color: var(--text);
  }

  .brand-mark {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .brand-name {
    padding-left: 0.7rem;
    border-left: 1px solid var(--line-2);
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--text-2);
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .nav a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.2;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05rem;
    height: 2px;
    background: var(--maize);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-2);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--line-2);
  }

  .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }

  :global([data-theme='light']) .moon {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  .menu-btn path {
    transform-origin: 10px 10px;
    transition: transform 0.25s var(--ease);
  }

  [data-open] .menu-btn .line-a {
    transform: translateY(3.5px) rotate(45deg);
  }

  [data-open] .menu-btn .line-b {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .mobile-menu ul {
    padding-block: 1rem 3rem;
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.1rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.1;
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-menu .index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  @media (max-width: 59.99rem) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: grid;
    }
  }

  @media (min-width: 60rem) {
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    .brand-name {
      display: none;
    }
  }
</style>
