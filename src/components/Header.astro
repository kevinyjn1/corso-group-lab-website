---
import Logo from './Logo.astro';
import { site, nav, href, isActive } from '../lib/site';

const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={href('/')} aria-label={`${site.name} home`}>
      <Logo size={44} tile />
      <span class="brand-mark">{site.mark}</span>
      <span class="brand-name">
        {site.name}
        <span>{site.university}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={href(item.path)}
              aria-current={isActive(current, item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color theme">
        <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle
            cx="10"
            cy="10"
            r="3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.75 1.75M14.25 14.25 16 16M16 4l-1.75 1.75M5.75 14.25 4 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path
            d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-btn"
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path class="line-a" d="M2 6.5h16" stroke="currentColor" stroke-width="1.5"></path>
          <path class="line-b" d="M2 13.5h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"></div>

  <div class="mobile-menu band--maize" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        {nav.map((item, i) => (
          <li>
            <a
              href={href(item.path)}
              aria-current={isActive(current, item.path) ? 'page' : undefined}
            >
              {item.label}
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;

  document
    .querySelector<HTMLButtonElement>('[data-theme-toggle]')
    ?.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
    });

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  function setMenu(open: boolean) {
    if (!header || !toggle || !menu) return;
    header.toggleAttribute('data-open', open);
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    root.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  // A maize bar along the bottom of the header shows how far down the page the visitor is.
  const progress = () => {
    const range = root.scrollHeight - window.innerHeight;
    root.style.setProperty('--read', range > 0 ? (window.scrollY / range).toFixed(4) : '0');
  };
  window.addEventListener('scroll', progress, { passive: true });
  window.addEventListener('resize', progress, { passive: true });
  progress();

  // Leaving the mobile layout closes the menu so the page is never left scroll-locked.
  window.matchMedia('(min-width: 66.01rem)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--rule) solid var(--text);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  /* Reading progress, drawn over the header's own rule. */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--rule) * -1);
    height: var(--rule);
    background: var(--maize);
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    color: var(--text);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-stretch: 66%;
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--text);
    font-family: var(--font-display);
    font-stretch: 88%;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand-name span {
    font-weight: 500;
    color: var(--text-3);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.15rem, 0.8vw, 0.6rem);
  }

  .nav a {
    display: block;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-display);
    font-stretch: 88%;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    /* The highlight wipes in from the left on hover. */
    background: linear-gradient(var(--maize), var(--maize)) left / 0 100% no-repeat;
    transition:
      background-size 0.25s var(--ease-out),
      color 0.2s var(--ease);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    background-size: 100% 100%;
    color: var(--blue);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--text);
    color: var(--text);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .icon-btn:hover {
    background: var(--text);
    color: var(--bg);
  }

  .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }

  :global([data-theme='light']) .moon {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  .menu-btn path {
    transform-origin: 10px 10px;
    transition: transform 0.25s var(--ease);
  }

  [data-open] .menu-btn .line-a {
    transform: translateY(3.5px) rotate(45deg);
  }

  [data-open] .menu-btn .line-b {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* On small screens the menu is a full field of maize with poster-sized links. */
  .mobile-menu {
    height: calc(100dvh - var(--header-h) - var(--rule));
    overflow-y: auto;
  }

  .mobile-menu ul {
    padding-block: 0.5rem 3rem;
  }

  .mobile-menu li {
    border-bottom: 2px solid var(--blue);
  }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 0.7rem 0.5rem;
    font-family: var(--font-display);
    font-stretch: 66%;
    font-size: clamp(1.9rem, 8vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .mobile-menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.08em;
  }

  .mobile-menu .index {
    font-stretch: 92%;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  @media (max-width: 66rem) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: grid;
    }
  }

  @media (min-width: 66.01rem) {
    .mobile-menu {
      display: none;
    }
  }

  /* Where the full navigation only just fits, the mark stands in for the group's name. */
  @media (min-width: 66.01rem) and (max-width: 77rem) {
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .brand-name {
      display: none;
    }
  }
</style>
