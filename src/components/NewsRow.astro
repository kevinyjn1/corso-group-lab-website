---
/**
 * One item of news: when, what happened, a sentence about it, and one link to read more.
 * The items are in src/data/news.yaml.
 */
import { paperOf, paperUrl } from '../lib/cite';
import { NEWS_KINDS, formatDate, getPublications, type NewsItem } from '../lib/content';
import { href as local } from '../lib/site';

interface Props {
  item: NewsItem;
  /** Heading level of the title: h3 under a section heading, h4 under a year. */
  level?: 'h3' | 'h4';
}
const { item, level: Heading = 'h3' } = Astro.props;
const { date, kind, title, summary, link, paper, linkLabel } = item.data;

/** Where the link goes: a paper's own address, a page of this site, or another site. */
const target = paper
  ? paperUrl(paperOf(await getPublications(), paper, `News item "${item.id}"`))
  : link;
if (!target) throw new Error(`News item "${item.id}": its paper has no address to link to`);
const outside = /^https?:/.test(target);
---

<li class="row" id={item.id} data-news={kind}>
  <p class="when">
    <time datetime={date}>{formatDate(date)}</time>
    <span class="kind">{NEWS_KINDS[kind]}</span>
  </p>
  <div>
    <Heading class="title">{title}</Heading>
    {summary && <p class="summary">{summary}</p>}
    <p class="more-line">
      {outside ? (
        <a class="go" href={target} rel="noopener">
          {linkLabel}&nbsp;<span aria-hidden="true">&nearr;</span>
        </a>
      ) : (
        <a class="go" href={local(target)}>
          {linkLabel}&nbsp;<span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </p>
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    align-items: start;
    padding-block: 1.35rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  /* The date leads, as on the media list, with the kind of news under it. */
  .when {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.2rem;
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .kind {
    font-weight: 500;
    color: var(--text-3);
  }

  .title {
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.18;
    text-wrap: balance;
  }

  .summary {
    max-width: 44rem;
    margin-top: 0.4rem;
    font-size: 0.975rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .more-line {
    margin-top: 0.6rem;
    font-size: 0.92rem;
  }

  .go {
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .go:hover {
    text-decoration-color: var(--maize);
  }

  .go span {
    font-weight: 500;
    color: var(--text-3);
  }

  @media (max-width: 48rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .when {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
    }
  }
</style>
