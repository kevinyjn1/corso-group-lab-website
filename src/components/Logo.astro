---
/** The group mark: a detection box locked onto a maize target. */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  class="logo"
  viewBox="0 0 28 28"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M1.75 8.5V1.75H8.5M19.5 1.75h6.75V8.5M26.25 19.5v6.75H19.5M8.5 26.25H1.75V19.5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  ></path>
  <rect x="9.5" y="9.5" width="9" height="9" fill="var(--maize)"></rect>
</svg>
