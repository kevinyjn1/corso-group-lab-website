---
/**
 * The animated "viewport" on the home page, and beneath it the four readings of the scene with
 * the papers they come from. See src/scripts/hero-scene.ts and src/lib/readings.ts.
 */
import { READINGS } from '../lib/readings';
---

<div class="scene">
  <figure class="viewport" data-hero-scene>
    <canvas aria-hidden="true"></canvas>
    <div class="hud">
      <div class="modes" role="group" aria-label="Choose how the scene is read">
        {READINGS.map((reading, i) => (
          <button type="button" data-mode={reading.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {reading.label}
          </button>
        ))}
      </div>
      <div class="hud-right">
        <p class="status" aria-hidden="true">
          <span class="live"></span>
          <span class="status-text">Illustration</span>
          <span class="frame">
            Frame <span data-frame>000000</span>
          </span>
        </p>
        <button
          type="button"
          class="hold"
          data-pause
          aria-pressed="false"
          aria-label="Pause the scene"
        >
          <svg class="icon-pause" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" fill="currentColor"></path>
          </svg>
          <svg class="icon-play" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path d="M4 2.5v11l9.5-5.5z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="caption" aria-hidden="true">
      <span class="caption-tag">Caption</span>
      <span class="caption-text">
        <span data-caption></span>
        <span class="cursor"></span>
      </span>
    </div>
    <figcaption class="sr-only">
      Animated illustration, not footage: seen from above, a surgeon's two hands sew a bypass graft
      onto a coronary artery of a beating heart, one stitch at a time, until blood flows past a
      blockage. The scene is read four ways that the group has published: the pose of each hand, the
      operation in words, the moving surface of the heart, and the path each hand travels.
    </figcaption>
  </figure>

  <ol class="readings" aria-label="The four readings and the papers they come from">
    {READINGS.map((reading, i) => (
      <li data-reading={reading.id} data-active={i === 0 ? '' : undefined}>
        <button type="button" class="reading-name" data-show={reading.id}>
          <span class="reading-index">{String(i + 1).padStart(2, '0')}</span>
          {reading.label}
        </button>
        <p class="reading-what">{reading.what}</p>
        <p class="reading-paper">
          <a href={reading.href} rel="noopener">
            {reading.paper} <span aria-hidden="true">&nearr;</span>
          </a>
          <span class="reading-venue">{reading.venue}</span>
        </p>
      </li>
    ))}
  </ol>
</div>

<script>
  import { mountHeroScene } from '../scripts/hero-scene';

  const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
  if (scene) mountHeroScene(scene);

  // The list under the scene follows the reading on show, and can choose it.
  const readings = [...document.querySelectorAll<HTMLElement>('[data-reading]')];
  document.addEventListener('hero-scene:view', (event) => {
    const view = (event as CustomEvent<string>).detail;
    for (const item of readings) item.toggleAttribute('data-active', item.dataset.reading === view);
  });
  for (const button of document.querySelectorAll<HTMLElement>('[data-show]')) {
    button.addEventListener('click', () => {
      scene?.querySelector<HTMLElement>(`[data-mode="${button.dataset.show}"]`)?.click();
      scene?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  }
</script>

<style>
  .viewport {
    position: relative;
    /* Sized so the whole scene, caption included, fits above the fold on a laptop. */
    height: clamp(22rem, min(44vw, 100svh - 26.5rem), 33rem);
    overflow: hidden;
    background: var(--screen);
    border: 1px solid var(--screen-line);
    border-radius: var(--radius-lg);
    color: var(--screen-text);
    font-family: var(--font-mono);
    cursor: crosshair;
    user-select: none;
    animation: power-on 1s var(--ease) 0.45s both;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
  }

  .hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem 0.65rem 0.65rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--screen-text-2);
    pointer-events: none;
  }

  .modes {
    display: flex;
    pointer-events: auto;
    background: rgb(5 8 15 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--screen-line);
    border-radius: var(--radius);
  }

  .modes button {
    position: relative;
    height: 1.75rem;
    padding-inline: 0.7rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--screen-text-2);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }

  .modes button + button {
    border-left: 1px solid var(--screen-line);
  }

  .modes button:hover,
  .modes button[aria-pressed='true'] {
    color: var(--screen-text);
  }

  /* Fills as the active view counts down to the next one; full once the visitor picks a view. */
  .modes button::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--maize);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  .modes button:not([aria-pressed='true'])::after {
    transform: scaleX(0);
  }

  .hud-right {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hold {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    background: rgb(5 8 15 / 0.72);
    border: 1px solid var(--screen-line);
    color: var(--screen-text-2);
    cursor: pointer;
    pointer-events: auto;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .hold:hover,
  .hold[aria-pressed='true'] {
    border-color: var(--maize);
    color: var(--maize);
  }

  .hold .icon-play,
  .hold[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .hold[aria-pressed='true'] .icon-play {
    display: block;
  }

  /* While the scene is held, the light that says it is live stops blinking. */
  .viewport[data-held] .live {
    animation: none;
    opacity: 0.4;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .frame {
    margin-left: 0.55rem;
  }

  .live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #ff5d5d;
    animation: pulse 1.6s ease-in-out infinite;
  }

  .caption {
    position: absolute;
    left: 1rem;
    right: 1rem;
    /* Sits just above the 58px timeline strip that the script draws. */
    bottom: calc(58px + 0.9rem);
    display: flex;
    align-items: stretch;
    pointer-events: none;
  }

  .caption-tag {
    display: flex;
    align-items: center;
    flex: none;
    padding-inline: 0.5rem;
    background: var(--maize);
    color: var(--on-maize);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Set like a subtitle, on its own dark plate, so it reads over any view of the scene. */
  .caption-text {
    padding: 0.2em 0.55em;
    background: rgb(5 8 15 / 0.86);
    font-size: clamp(0.8125rem, 1.25vw, 0.95rem);
    line-height: 1.5;
    color: var(--screen-text);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.15em;
    background: var(--maize);
    vertical-align: -0.15em;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes power-on {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.985);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* On narrow screens the script reserves a 98px strip under the scene for the caption. */
  .viewport[data-compact] .caption {
    flex-direction: column;
    align-items: flex-start;
    bottom: auto;
    top: calc(100% - 98px + 0.6rem);
  }

  .viewport[data-compact] .caption-tag {
    padding-block: 0.3rem;
  }

  .viewport[data-compact] .caption-text {
    padding-inline: 0;
    background: none;
  }

  /* --- The readings, listed under the scene --------------------------------- */

  .readings {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .readings li {
    padding: 0.8rem clamp(0.9rem, 1.6vw, 1.5rem) 0.25rem;
    border-top: var(--rule) solid var(--line-2);
    transition: border-color 0.3s var(--ease);
  }

  .readings li + li {
    border-left: 1px solid var(--line);
  }

  .readings li:first-child {
    padding-left: 0;
  }

  /* The reading on show is marked the way the active tab is. */
  .readings li[data-active] {
    border-top-color: var(--maize);
  }

  .reading-name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-2);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }

  .reading-name:hover,
  li[data-active] .reading-name {
    color: var(--maize);
  }

  .reading-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }

  .reading-what {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .reading-paper {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .reading-paper a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.2em;
  }

  .reading-paper a:hover {
    text-decoration-color: var(--maize);
  }

  .reading-venue {
    font-family: var(--font-display);
    font-stretch: 92%;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  @media (max-width: 62rem) {
    .readings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .readings li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 38rem) {
    .readings {
      grid-template-columns: minmax(0, 1fr);
    }

    .readings li,
    .readings li + li {
      padding-inline: 0;
      border-left: 0;
    }
  }

  @media (max-width: 44rem) {
    .frame {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .status-text {
      display: none;
    }

    .modes button {
      padding-inline: 0.55rem;
    }
  }
</style>
