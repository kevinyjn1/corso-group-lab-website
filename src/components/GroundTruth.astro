---
/** Ground Truth, the hidden annotation game. See src/scripts/game/ground-truth.ts. */
import { href } from '../lib/site';
import { ROUND_SECONDS, clock } from '../scripts/game/rules';
---

<div class="game" data-game>
  <canvas aria-hidden="true"></canvas>

  <div class="timebar" data-timebar aria-hidden="true"></div>
  <div class="hud" aria-hidden="true">
    <p class="readout">
      <span class="key">Score</span>
      <span class="value" data-score>
        0
      </span>
    </p>
    <p class="readout">
      <span class="key">Streak</span>
      <span class="value" data-streak>
        x1.0
      </span>
    </p>
    <p class="status">
      <span class="live"></span>
      <span data-condition>Standby</span>
    </p>
    <p class="readout">
      <span class="key">Time</span>
      <span class="value" data-time>
        {clock(ROUND_SECONDS)}
      </span>
    </p>
  </div>

  <div class="panel" data-start-panel>
    <div class="card ticks">
      <p class="label label--accent">Annotation task 001</p>
      <h2>
        The model needs <em>labels</em>.
      </h2>
      <ol class="how">
        <li>Drag a box around everything that moves.</li>
        <li>Tight boxes score higher. Under 0.5 IoU does not count.</li>
        <li>Small, fast targets are worth more, and streaks multiply.</li>
      </ol>
      <div class="actions">
        <button class="btn btn--primary" type="button" data-start>
          Start labeling{' '}
          <span class="arrow" aria-hidden="true">
            &rarr;
          </span>
        </button>
        <p class="best" data-best hidden>
          Your best <span data-best-value>0</span>
        </p>
      </div>
    </div>
  </div>

  <div class="panel" data-results-panel hidden>
    <div class="card ticks">
      <p class="label label--accent">Round complete</p>
      <p class="score">
        <span data-final-score>0</span>
        <span class="unit">points</span>
        <span class="best" data-record></span>
      </p>
      <h2 tabindex="-1" data-rank>
        Random initialization
      </h2>
      <p class="rank-line" data-rank-line></p>
      <dl class="results">
        <div>
          <dt>Labeled</dt>
          <dd data-stat-labeled>0 of 0</dd>
          <dd class="sub" data-stat-recall>
            0% recall
          </dd>
        </div>
        <div>
          <dt>Mean IoU</dt>
          <dd data-stat-iou>0.00</dd>
        </div>
        <div>
          <dt>Precision</dt>
          <dd data-stat-precision>0%</dd>
        </div>
        <div>
          <dt>Best streak</dt>
          <dd data-stat-streak>0</dd>
        </div>
      </dl>
      <div class="actions">
        <button class="btn btn--primary" type="button" data-start>
          Label again
        </button>
        <a class="btn" href={href('/research/')}>
          See the research
        </a>
      </div>
    </div>
  </div>

  <p class="sr-only" role="status" data-announce></p>
  <p class="sr-only">
    This game is played by dragging with a mouse, trackpad, or finger. Figures cross a scene and you
    draw a box around each one; boxes are scored by how closely they match the true outline.
  </p>
</div>

<script>
  import { mountGroundTruth } from '../scripts/game/ground-truth';

  const game = document.querySelector<HTMLElement>('[data-game]');
  if (game) mountGroundTruth(game);
</script>

<style>
  /* The game screen stays dark in both themes, like the scene on the home page. */
  .game {
    --text: #eef1f6;
    --text-2: #a9b3c6;
    --text-3: #76829a;
    --line: rgb(255 255 255 / 0.09);
    --line-2: rgb(255 255 255 / 0.18);
    --accent: var(--maize);

    position: relative;
    /* Sized so the whole screen fits under the page title on a laptop. */
    height: clamp(30rem, 100svh - 17.5rem, 40rem);
    overflow: hidden;
    background: var(--screen);
    border: 1px solid var(--screen-line);
    border-radius: var(--radius-lg);
    color: var(--screen-text);
    user-select: none;
    -webkit-user-select: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    /* Dragging draws a box; it must never scroll the page. */
    touch-action: none;
  }

  .game[data-phase='playing'] canvas {
    cursor: crosshair;
  }

  .timebar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--maize);
    transform: scaleX(var(--left, 1));
    transform-origin: left;
  }

  .hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 46px;
    padding-inline: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--screen-text-2);
    pointer-events: none;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .value {
    min-width: 2.6em;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--screen-text);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    white-space: nowrap;
  }

  .live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--screen-text-2);
  }

  .game[data-phase='playing'] .live {
    background: #ff5d5d;
    animation: pulse 1.6s ease-in-out infinite;
  }

  .panel {
    position: absolute;
    inset: 46px 0 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(5 8 15 / 0.55);
    animation: panel-in 0.4s var(--ease) both;
  }

  .card {
    --tick: 0.875rem;
    --tick-color: var(--maize);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: min(100%, 30rem);
    padding: clamp(1.25rem, 3.5vw, 1.75rem);
    background-color: rgb(5 8 15 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    outline: none;
  }

  h2 em {
    color: var(--maize);
  }

  .how {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: how;
    font-size: 0.925rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .how li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    counter-increment: how;
  }

  .how li::before {
    content: counter(how, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--maize);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem;
  }

  .actions .btn {
    height: 2.7rem;
  }

  .best {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .best[data-new] {
    color: var(--maize);
  }

  .score {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 11vw, 4.25rem);
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    color: var(--maize);
  }

  .score .best {
    margin-left: auto;
  }

  .unit {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .rank-line {
    margin-top: -0.6rem;
    font-size: 0.925rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--line);
  }

  .results div {
    padding: 0.8rem 0.5rem 0.8rem 0.75rem;
  }

  .results div:first-child {
    padding-left: 0;
  }

  .results div + div {
    border-left: 1px solid var(--line);
  }

  .results dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-3);
  }

  .results dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .results .sub {
    margin-top: 0.15rem;
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }

  /* On phones the screen fills the view under the site header, so nothing scrolls mid-round. */
  @media (max-width: 44rem) {
    .game {
      height: clamp(28rem, 100svh - 7rem, 36rem);
    }
  }

  @media (max-width: 34rem) {
    .hud {
      gap: 1rem;
      padding-inline: 0.75rem;
    }

    .panel {
      padding: 0.75rem;
    }

    .actions {
      gap: 0.6rem;
    }

    .actions .btn {
      padding-inline: 0.9rem;
      font-size: 0.875rem;
    }

    .results .sub {
      display: none;
    }

    .status span:last-child {
      display: none;
    }

    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .results div + div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .results div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .game[data-phase='playing'] .live {
      animation: none;
    }
  }
</style>
