---
/**
 * The group's flagship project, introduced on the home page and the Research page: its name, what
 * it is, the team's own footage of it at work, and four numbers. The project's page has the rest.
 */
import { Image } from 'astro:assets';
import Clip from './Clip.astro';
import VigilName from './VigilName.astro';
import { href } from '../lib/site';
import { vigil } from '../lib/vigil';
import projection from '../assets/clips/vigil-projection.mp4';
import projectionPoster from '../assets/clips/posters/vigil-projection.jpg';
import vigilMark from '../assets/vigil/vigil-mark.png';

interface Props {
  /** Heading level of the project's name. */
  level?: 'h2' | 'h3';
  /** The line above the name: by default, that this is the flagship project. */
  kicker?: string;
  /** A number set before that line, when the band is one of a numbered series of claims. */
  number?: string;
}
const { level: Heading = 'h2', kicker = 'Flagship project', number } = Astro.props;
const { award } = vigil;
---

<section class="vigil band--blue" aria-labelledby="vigil-band-title">
  <div class="container">
    <div class="vigil-head" data-reveal>
      <p class="label label--accent kicker">
        <Image src={vigilMark} alt="" width={36} height={36} />
        {number && <span class="kicker-n">{number}</span>}
        {kicker}
      </p>
      <p class="label">
        {award.funder} &middot; {award.program} &middot; {award.amount}
      </p>
    </div>

    <div class="vigil-grid" data-reveal="stagger">
      <div class="vigil-text">
        <Heading class="wordmark" id="vigil-band-title">
          {vigil.name}
        </Heading>
        <VigilName />
        <p class="lead">{vigil.summary}</p>
        <div class="cta">
          <a class="btn btn--primary" href={href(vigil.path)}>
            Inside VIGIL{' '}
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
          <a class="btn" href={href(`${vigil.path}#watch`)}>
            Watch the walkthrough
          </a>
        </div>
      </div>
      <div class="vigil-figure">
        <Clip
          src={projection}
          poster={projectionPoster}
          tag="Footage · VIGIL"
          alt="Seen from above, a patient in a gown lies on a bed while a clinician stands at the head. Lines of light projected onto the bed show where the patient should lie. A caption reads: VIGIL upskills the medical practitioner by dynamically projecting guidance content in the scene. A close-up then shows a score projected onto the bed beside the patient."
        >
          <strong>Guidance, projected into the room.</strong> VIGIL lines the patient up with light
          on the bed, then projects its reading beside them. From the team's own demonstration
          video.{' '}
          <a class="more" href={href(`${vigil.path}#how`)}>
            See each part at work <span aria-hidden="true">&rarr;</span>
          </a>
        </Clip>
      </div>
    </div>
  </div>
</section>

<style>
  .vigil {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  /* The band opens on a maize rule, with the project's standing on the left and its funder on
     the right. */
  .vigil-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1rem;
    border-top: var(--rule) solid var(--maize);
  }

  /* The number of a claim, set as the claims before it are, in the band's own colors. */
  .kicker-n {
    padding: 0.15rem 0.4rem;
    background: var(--maize);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--blue);
  }

  /* The project's own mark sits beside the line that introduces it. */
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .kicker :global(img) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .vigil-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* The name is a wordmark: a step larger than the section headings around it. */
  .wordmark {
    font-family: var(--font-display);
    font-stretch: 66%;
    font-weight: 900;
    font-size: clamp(3rem, 6.4vw, 5rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--maize);
  }

  .vigil-text :global(.vigil-name) {
    margin-top: 1.4rem;
  }

  .lead {
    max-width: 34rem;
    margin-top: 1.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* The clip is footage, so it gets a frame of its own, and its caption reads on the dark band. */
  .vigil-figure :global(.clip-frame) {
    border: var(--rule) solid var(--maize);
  }

  .vigil-figure :global(figcaption) {
    color: var(--text-2);
  }

  .more {
    color: var(--maize);
    font-weight: 600;
    white-space: nowrap;
  }

  .more:hover {
    text-decoration: underline;
  }

  @media (max-width: 62rem) {
    .vigil-grid {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 38rem) {
    .cta .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
