---
/**
 * A figure from one of the group's papers, shown as published, with the paper it is from.
 * The figures and their captions are in src/lib/paper-figures.ts.
 */
import { getImage, Image } from 'astro:assets';
import { paperOf, paperUrl, shortCite } from '../lib/cite';
import { getPublications } from '../lib/content';
import { PAPER_FIGURES, type PaperFigureName } from '../lib/paper-figures';

interface Props {
  name: PaperFigureName;
}
const figure = PAPER_FIGURES[Astro.props.name];
const pub = paperOf(await getPublications(), figure.paper, 'PaperFigure');
const part = 'part' in figure && figure.part;
const cite = `${part ? 'Part of ' : ''}${figure.label} of ${shortCite(pub)}`;
const url = paperUrl(pub);
const credit = 'credit' in figure ? figure.credit : undefined;
/** The whole figure at the size it was cut, for reading its small print. */
const full = await getImage({ src: figure.image, width: figure.image.width, quality: 90 });
---

<figure
  class="paper-figure"
  data-paper-figure={figure.paper}
  style={`--ar: ${(figure.image.width / figure.image.height).toFixed(4)}`}
>
  <a class="sheet" href={full.src} aria-label={`Open ${cite} at full size`}>
    <Image
      src={figure.image}
      alt={figure.alt}
      widths={[480, 720, 960, 1280, figure.image.width].filter(
        (width, i, all) => width <= figure.image.width && all.indexOf(width) === i,
      )}
      sizes="(min-width: 62rem) 46rem, 92vw"
      quality={86}
    />
  </a>
  <figcaption>
    <p class="meta">
      <span class="tag">From the paper</span>
      {url ? (
        <a class="source" href={url} rel="noopener" title={pub.data.title} set:text={cite} />
      ) : (
        <span class="source" title={pub.data.title} set:text={cite} />
      )}
    </p>
    <p class="text">
      {figure.caption}
      {credit && <span class="credit">{credit}</span>}
    </p>
  </figcaption>
</figure>

<style>
  .paper-figure {
    margin: 0;
  }

  /* Paper figures are drawn on white, so they sit on a white sheet in both themes. */
  .sheet {
    display: block;
    padding: clamp(0.6rem, 1.4vw, 1rem);
    cursor: zoom-in;
    background: #fff;
    border: var(--rule) solid var(--text);
  }

  .sheet:focus-visible {
    outline: 3px solid var(--maize);
    outline-offset: 2px;
  }

  /* The figure fills the sheet's width, unless a page caps its height (--figure-max-h): then a
     tall figure is shown whole at that height, centered on the sheet. Its size comes from its
     proportions (--ar), so it is right before the image has loaded. */
  .sheet :global(img) {
    display: block;
    width: min(100%, calc(var(--figure-max-h, 1000rem) * var(--ar)));
    height: auto;
    margin-inline: auto;
  }

  /* Under the sheet: where the figure is from on one line, then what to notice in it. */
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.7rem;
  }

  .tag {
    padding: 0.25rem 0.45rem;
    background: var(--maize);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--blue);
  }

  .text {
    margin-top: 0.4rem;
    text-wrap: pretty;
  }

  .source {
    font-weight: 600;
    color: var(--text);
  }

  a.source {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  a.source:hover {
    text-decoration-color: var(--maize);
  }

  /* On a phone the tag always sits on its own line, so every caption starts the same way. */
  @media (max-width: 30rem) {
    .meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .credit {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--text-3);
  }
</style>
