---
import { getAreas, LINK_LABELS, TYPE_LABELS, type Publication } from '../lib/content';
import { pi } from '../lib/site';

interface Props {
  pub: Publication;
  /** Heading level for the title; depends on where the list sits in the page outline. */
  level?: 'h3' | 'h4';
}

const { pub, level: Title = 'h3' } = Astro.props;
const { data } = pub;
const badge = data.venueShort ?? TYPE_LABELS[data.type];
const piName = pi.name.replace(/^(\w)\w+ (\w)\. /, '$1. $2. ');
const links = Object.entries(data.links) as [string, string][];
/** The name of each research area, as the legend and the filters show it. */
const areaNames = new Map((await getAreas()).map((area) => [area.id, area.data.short]));
/**
 * A paper by a large consortium names its first three authors and counts the rest, so one row
 * does not run to ten lines. The search still covers every author.
 */
const MANY_AUTHORS = 12;
const named = data.authors.length > MANY_AUTHORS ? data.authors.slice(0, 3) : data.authors;
const others = data.authors.length - named.length;
const piAmongOthers = others > 0 && !named.includes(piName) && data.authors.includes(piName);
/** A preprint's tag and its link already say where it is, so its venue line is left out. */
const showVenue = data.type !== 'preprint' || Boolean(data.note);
const search = [
  data.title,
  data.authors.join(' '),
  data.venue,
  data.venueShort,
  data.year,
  data.note,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<li
  class="pub"
  id={pub.id}
  data-pub
  data-year={data.year}
  data-type={data.type}
  data-topics={data.topics.join(' ')}
  data-search={search}
>
  <div class="meta">
    <span class="venue">{badge}</span>
    <span class="year">{data.year}</span>
  </div>
  <div class="body">
    <Title class="title">{data.title}</Title>
    <p class="authors" title={others > 0 ? data.authors.join(', ') : undefined}>
      {[
        ...named.flatMap((author, i) => [
          i > 0 ? ', ' : '',
          <span class:list={['author', { pi: author === piName }]}>{author}</span>,
        ]),
        others > 0 ? `, and ${others} others` : '',
        ...(piAmongOthers ? [', including ', <span class="author pi">{piName}</span>] : []),
      ]}
    </p>
    {showVenue && (
      <p class="where">
        <span>{data.venue}</span>
        {data.note && <span class="note">{data.note}</span>}
      </p>
    )}
  </div>
  <div class="side">
    <ul class="topics" aria-label="Research areas">
      {data.topics.map((t) => (
        <li data-topic={t} title={areaNames.get(t)}>
          <span class="dot" />
          <span class="sr-only">{areaNames.get(t) ?? t}</span>
        </li>
      ))}
    </ul>
    {links.length > 0 && (
      <ul class="links">
        {links.map(([kind, url]) => (
          <li>
            <a href={url} rel="noopener">
              {LINK_LABELS[kind]}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>

<style>
  .pub {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) minmax(8rem, auto);
    gap: 0.5rem 2rem;
    align-items: start;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .venue {
    color: var(--accent);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .year {
    color: var(--text-3);
  }

  .title {
    font-family: var(--font-sans);
    font-size: 1.075rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .authors {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  /* A name stays whole: initials never end one line with the surname on the next. */
  .author {
    white-space: nowrap;
  }

  .pi {
    color: var(--text);
    font-weight: 500;
  }

  /* A badge that does not fit after the venue starts the next line at the left edge. */
  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-3);
  }

  .note {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: 0.05em;
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    padding-top: 0.35rem;
  }

  .topics {
    display: flex;
    gap: 0.3rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
    max-width: 18.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    height: 1.6rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .links a:hover {
    background: var(--maize);
    border-color: var(--maize);
    color: var(--on-maize);
  }

  @media (max-width: 52rem) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }

    .meta {
      flex-direction: row;
      gap: 0.75rem;
      padding-top: 0;
    }

    .side {
      flex-direction: row-reverse;
      align-items: center;
      justify-content: flex-end;
      gap: 0.9rem;
      padding-top: 0.2rem;
    }

    .links {
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
